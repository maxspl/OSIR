# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.file.path) && exists(.file.hash.sha1) {
  .message = "Amcache file entry exists for " + to_string!(.file.path) + " (SHA1 " + to_string!(.file.hash.sha1) + ")"
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.file.path), "target": to_string!(.file.hash.sha1), "type": "hashed as"})
}
if .labels.is_connected == true && exists(.labels.friendly_name) {
  .message = "Device " + to_string!(.labels.friendly_name) + " was connected"
}
##############################################################
# Module VRL : snap
# Version    : 1.0
# OSIR - snap package list normalizer
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] name -> package.name
if exists(.name) {
  .package.name = .name
}

# [normalization] version -> package.version
if exists(.version) {
  .package.version = .version
}

# [normalization] rev -> package.reference
if exists(.rev) {
  .package.reference = .rev
}

# [normalization] tracking -> package.type
if exists(.tracking) {
  .package.type = .tracking
}

# [normalization] publisher -> package.vendor
if exists(.publisher) {
  .package.vendor = .publisher
}

# [normalization] Notes -> message
if exists(.Notes) {
  .message = .Notes
}

# [deletion] name, version, rev, tracking, publisher, Notes
del(.name)
del(.version)
del(.rev)
del(.tracking)
del(.publisher)
del(.Notes)

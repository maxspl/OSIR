##############################################################
# Module VRL : audit_vrl
# Version    : 1.0
# osir-audit | Osir Transform description to normalize audit log file.
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."event.kind") {
  .event.kind = get!(., path: ["event.kind"])
  del(."event.kind")
}
if exists(."host.name") {
  .host.name = get!(., path: ["host.name"])
  del(."host.name")
}
if exists(."user.name") {
  .user.name = get!(., path: ["user.name"])
  del(."user.name")
}
if exists(."user.id") {
  .user.id = get!(., path: ["user.id"])
  del(."user.id")
}
if exists(."audit.message") {
  .audit.message = get!(., path: ["audit.message"])
  del(."audit.message")
}
if exists(."audit.scontext") {
  .audit.scontext = get!(., path: ["audit.scontext"])
  del(."audit.scontext")
}
if exists(."audit.tcontext") {
  .audit.tcontext = get!(., path: ["audit.tcontext"])
  del(."audit.tcontext")
}
if exists(."audit.tclass") {
  .audit.tclass = get!(., path: ["audit.tclass"])
  del(."audit.tclass")
}
if exists(."audit.old") {
  .audit.old = get!(., path: ["audit.old"])
  del(."audit.old")
}
if exists(."process.executable") {
  .process.executable = get!(., path: ["process.executable"])
  del(."process.executable")
}
if exists(."process.pid") {
  .process.pid = get!(., path: ["process.pid"])
  del(."process.pid")
}
if exists(."process.command_line") {
  .process.command_line = get!(., path: ["process.command_line"])
  del(."process.command_line")
}
if exists(."event.action") {
  .event.action = get!(., path: ["event.action"])
  del(."event.action")
}
if exists(."process.name") {
  .process.name = get!(., path: ["process.name"])
  del(."process.name")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] from_unix_timestamp!(to_int!(._time)) -> timestamp
if exists(._time) {
  .timestamp = from_unix_timestamp!(to_int!(._time))
}

# [normalization] to_string!(.type) -> event.kind
if exists(.type) {
  .event.kind = to_string!(.type)
}

# [normalization] to_string!(.res) -> event.outcome
if exists(.res) {
  .event.outcome = to_string!(.res)
}

# [normalization] to_string!(._raw) -> event.original
if exists(._raw) {
  .event.original = to_string!(._raw)
}

# [translation] type -> event.category
if exists(.type) {
  .event.category = get(value: {
  "SYSCALL": "process",
  "LOGIN": "authentication",
  "USER_AUTH": "authentication",
  "USER_LOGIN": "authentication",
  "USER_LOGOUT": "authentication",
  "AVC": "intrusion_detection",
  "CONFIG_CHANGE": "configuration",
  "SERVICE_START": "process",
  "SERVICE_STOP": "process",
  "SOFTWARE_UPDATE": "package",
  "SYSTEM_BOOT": "host",
  "SYSTEM_SHUTDOWN": "host",
}, path: [to_string!(.type)]) ?? "other"
}

# [translation] type -> event.type
if exists(.type) {
  .event.type = get(value: {
  "SYSCALL": "access",
  "LOGIN": "start",
  "USER_AUTH": "authentication",
  "USER_LOGIN": "start",
  "USER_LOGOUT": "end",
  "AVC": "denied",
  "CONFIG_CHANGE": "change",
  "SERVICE_START": "start",
  "SERVICE_STOP": "end",
  "SOFTWARE_UPDATE": "change",
  "SYSTEM_BOOT": "start",
  "SYSTEM_SHUTDOWN": "end",
}, path: [to_string!(.type)]) ?? "info"
}

# [translation] type -> event.action
if exists(.type) {
  .event.action = get(value: {
  "ADD_USER": "user-add",
  "ADD_GROUP": "group-add",
  "CRED_ACQ": "credential-acquire",
  "CRED_DISP": "credential-dispose",
  "CRED_REFR": "credential-refresh",
  "USER_CMD": "command-execution",
}, path: [to_string!(.type)]) ?? "not-found"
}

# [normalization] to_string!(.pid) -> process.pid
if exists(.pid) {
  .process.pid = to_string!(.pid)
}

# [normalization] to_string!(.ppid) -> process.ppid
if exists(.ppid) {
  .process.ppid = to_string!(.ppid)
}

# [normalization] to_string!(.comm) -> process.name
if exists(.comm) {
  .process.name = to_string!(.comm)
}

# [normalization] to_string!(.exe) -> process.executable
if exists(.exe) {
  .process.executable = to_string!(.exe)
}

# [normalization] to_string!(.command_line) -> process.command_line
if exists(.command_line) {
  .process.command_line = to_string!(.command_line)
}

# [normalization] to_string!(.cwd) -> process.working_directory
if exists(.cwd) {
  .process.working_directory = to_string!(.cwd)
}

# [normalization] to_string!(.spid) -> process.thread.id
if exists(.spid) {
  .process.thread.id = to_string!(.spid)
}

# [normalization] to_string!(.uid) -> user.id
if exists(.uid) {
  .user.id = to_string!(.uid)
}

# [normalization] to_string!(.acct) -> user.name
if exists(.acct) {
  .user.name = to_string!(.acct)
}

# [normalization] to_string!(.euid) -> user.effective.id
if exists(.euid) {
  .user.effective.id = to_string!(.euid)
}

# [normalization] to_string!(.acct) -> user.effective.name
if exists(.acct) {
  .user.effective.name = to_string!(.acct)
}

# [normalization] to_string!(.suid) -> user.target.id
if exists(.suid) {
  .user.target.id = to_string!(.suid)
}

# [normalization] to_string!(.acct) -> user.target.name
if exists(.acct) {
  .user.target.name = to_string!(.acct)
}

# [normalization] to_string!(.gid) -> user.group.id
if exists(.gid) {
  .user.group.id = to_string!(.gid)
}

# [normalization] to_string!(.group) -> user.group.name
if exists(.group) {
  .user.group.name = to_string!(.group)
}

# [normalization] to_string!(.auid) -> user.audit.id
if exists(.auid) {
  .user.audit.id = to_string!(.auid)
}

# [normalization] to_string!(.ses) -> user.session.id
if exists(.ses) {
  .user.session.id = to_string!(.ses)
}

# [normalization] to_string!(.hostname) -> host.name
if exists(.hostname) {
  .host.name = to_string!(.hostname)
}

# [normalization] to_string!(.addr) -> host.ip
if exists(.addr) {
  .host.ip = to_string!(.addr)
}

# [normalization] to_string!(.ses) -> audit.session
if exists(.ses) {
  .audit.session = to_string!(.ses)
}

# [normalization] to_string!(.auid) -> audit.id
if exists(.auid) {
  .audit.id = to_string!(.auid)
}

# [normalization] to_string!(.res) -> audit.result
if exists(.res) {
  .audit.result = to_string!(.res)
}

# [normalization] to_string!(.msg) -> audit.message
if exists(.msg) {
  .audit.message = to_string!(.msg)
}

# [normalization] to_string!(.tag) -> audit.tag
if exists(.tag) {
  .audit.tag = to_string!(.tag)
}

# [normalization] to_string!(.key) -> audit.key
if exists(.key) {
  .audit.key = to_string!(.key)
}

# [normalization] to_string!(.direction) -> network.direction
if exists(.direction) {
  .network.direction = to_string!(.direction)
}

# [normalization] to_string!(.addr) -> source.ip
if exists(.addr) {
  .source.ip = to_string!(.addr)
}

# [normalization] to_string!(.rport) -> source.port
if exists(.rport) {
  .source.port = to_string!(.rport)
}

# [normalization] to_string!(.laddr) -> destination.ip
if exists(.laddr) {
  .destination.ip = to_string!(.laddr)
}

# [normalization] to_string!(.lport) -> destination.port
if exists(.lport) {
  .destination.port = to_string!(.lport)
}

# [normalization] to_string!(.name) -> file.name
if exists(.name) {
  .file.name = to_string!(.name)
}

# [normalization] to_string!(.path) -> file.path
if exists(.path) {
  .file.path = to_string!(.path)
}

# [normalization] to_string!(.dev) -> file.device
if exists(.dev) {
  .file.device = to_string!(.dev)
}

# [normalization] to_string!(.ino) -> file.inode
if exists(.ino) {
  .file.inode = to_string!(.ino)
}

# [normalization] to_string!(.root_dir) -> file.directory
if exists(.root_dir) {
  .file.directory = to_string!(.root_dir)
}

# [normalization] to_string!(.auid) -> system.audit.id
if exists(.auid) {
  .system.audit.id = to_string!(.auid)
}

# [normalization] to_string!(.ses) -> system.audit.session
if exists(.ses) {
  .system.audit.session = to_string!(.ses)
}

# [normalization] to_string!(.proctitle) -> system.audit.command
if exists(.proctitle) {
  .system.audit.command = to_string!(.proctitle)
}

# [normalization] to_string!(.tty) -> system.audit.tty
if exists(.tty) {
  .system.audit.tty = to_string!(.tty)
}

# [normalization] to_string!(.terminal) -> system.audit.terminal
if exists(.terminal) {
  .system.audit.terminal = to_string!(.terminal)
}

# [normalization] to_string!(.level) -> system.audit.runlevel
if exists(.level) {
  .system.audit.runlevel = to_string!(.level)
}

# [deletion] _raw, _time, type, acct, addr, auid, comm, exe, hostname, msg, pid, res, ses, subj, tag, terminal, uid, ppid, command_line, cwd, spid, gid, group, suid, tty, level, key, name, path, dev, ino, root_dir, direction, laddr, lport, rport, proctitle, grantors, id, old, family, table, entries, cipher, ksize, mac, pfs, fp, sauid, scontext, tcontext, tclass, seqno, a0, a1, a2, a3, arch, egid, euid, exit, fsgid, fsuid, items, sgid, success, syscall, ver, kernel, format, op, state, context, sw_type, gpg_res, key_enforce
del(._raw)
del(._time)
del(.type)
del(.acct)
del(.addr)
del(.auid)
del(.comm)
del(.exe)
del(.hostname)
del(.msg)
del(.pid)
del(.res)
del(.ses)
del(.subj)
del(.tag)
del(.terminal)
del(.uid)
del(.ppid)
del(.command_line)
del(.cwd)
del(.spid)
del(.gid)
del(.group)
del(.suid)
del(.tty)
del(.level)
del(.key)
del(.name)
del(.path)
del(.dev)
del(.ino)
del(.root_dir)
del(.direction)
del(.laddr)
del(.lport)
del(.rport)
del(.proctitle)
del(.grantors)
del(.id)
del(.old)
del(.family)
del(.table)
del(.entries)
del(.cipher)
del(.ksize)
del(.mac)
del(.pfs)
del(.fp)
del(.sauid)
del(.scontext)
del(.tcontext)
del(.tclass)
del(.seqno)
del(.a0)
del(.a1)
del(.a2)
del(.a3)
del(.arch)
del(.egid)
del(.euid)
del(.exit)
del(.fsgid)
del(.fsuid)
del(.items)
del(.sgid)
del(.success)
del(.syscall)
del(.ver)
del(.kernel)
del(.format)
del(.op)
del(.state)
del(.context)
del(.sw_type)
del(.gpg_res)
del(.key_enforce)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.event.kind) && exists(.host.name) {
  .message = "Audit event of type " + to_string!(.event.kind) + " occurred on " + to_string!(.host.name)
}
if .event.kind == "ADD_GROUP" && exists(.host.name) {
  .message = "Group was added on " + to_string!(.host.name)
}
if .event.kind == "SOFTWARE_UPDATE" && exists(.host.name) {
  .message = "Software update performed on " + to_string!(.host.name)
}
if .event.kind == "SYSTEM_BOOT" && exists(.host.name) {
  .message = "System booted on " + to_string!(.host.name)
}
if .event.kind == "SYSTEM_SHUTDOWN" && exists(.host.name) {
  .message = "System shutdown initiated on " + to_string!(.host.name)
}
if .event.kind == "DAEMON_START" && exists(.process.pid) && exists(.host.name) {
  .message = "Audit daemon started (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "DAEMON_END" && exists(.process.pid) && exists(.host.name) {
  .message = "Audit daemon stopped (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "ADD_USER" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "User " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") was added on " + to_string!(.host.name)
}
if .event.kind == "CONFIG_CHANGE" && exists(.audit.message) && exists(.audit.old) && exists(.host.name) {
  .message = "Audit configuration changed: " + to_string!(.audit.message) + " (old=" + to_string!(.audit.old) + ") on " + to_string!(.host.name)
}
if .event.kind == "CRED_ACQ" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "Credentials acquired by user " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") on " + to_string!(.host.name)
}
if .event.kind == "CRED_DISP" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "Credentials disposed by user " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") on " + to_string!(.host.name)
}
if .event.kind == "CRED_REFR" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "Credentials refreshed by user " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") on " + to_string!(.host.name)
}
if .event.kind == "CRYPTO_KEY_USER" && exists(.process.executable) && exists(.process.pid) && exists(.host.name) {
  .message = "Crypto key used by process " + to_string!(.process.executable) + " (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "CRYPTO_SESSION" && exists(.process.executable) && exists(.process.pid) && exists(.host.name) {
  .message = "Crypto session established by process " + to_string!(.process.executable) + " (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "LOGIN" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "User " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") logged in on " + to_string!(.host.name)
}
if .event.kind == "USER_AUTH" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "User " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") authenticated on " + to_string!(.host.name)
}
if .event.kind == "USER_LOGIN" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "User " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") logged in on " + to_string!(.host.name)
}
if .event.kind == "USER_LOGOUT" && exists(.user.name) && exists(.user.id) && exists(.host.name) {
  .message = "User " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ") logged out from " + to_string!(.host.name)
}
if .event.kind == "USER_CMD" && exists(.process.command_line) && exists(.user.name) && exists(.user.id) {
  .message = "Command " + to_string!(.process.command_line) + " executed by user " + to_string!(.user.name) + " (UID: " + to_string!(.user.id) + ")"
}
if .event.kind == "SERVICE_START" && exists(.process.name) && exists(.process.pid) && exists(.host.name) {
  .message = "Service " + to_string!(.process.name) + " started (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "SERVICE_STOP" && exists(.process.name) && exists(.process.pid) && exists(.host.name) {
  .message = "Service " + to_string!(.process.name) + " stopped (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "SYSCALL" && exists(.event.action) && exists(.process.name) && exists(.process.pid) && exists(.host.name) {
  .message = "Syscall " + to_string!(.event.action) + " executed by process " + to_string!(.process.name) + " (PID: " + to_string!(.process.pid) + ") on " + to_string!(.host.name)
}
if .event.kind == "AVC" && exists(.audit.message) && exists(.audit.scontext) && exists(.audit.tcontext) && exists(.audit.tclass) && exists(.host.name) {
  .message = "AVC denial: " + to_string!(.audit.message) + " (scontext=" + to_string!(.audit.scontext) + ", tcontext=" + to_string!(.audit.tcontext) + ", tclass=" + to_string!(.audit.tclass) + ") on " + to_string!(.host.name)
}
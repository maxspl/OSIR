##############################################################
# Module VRL : powershell_history
# Version    : 1.0
# Windows PowerShell History JSONL → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."process.command_line") {
  .process.command_line = get!(., path: ["process.command_line"])
  del(."process.command_line")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
if !exists(.event.original) {
  .event.original = encode_json!(.)
}

# [normalization] command -> process.command_line
if exists(.command) {
  .process.command_line = .command
}

# [normalization] line_number -> event.sequence
if exists(.line_number) {
  _result, err = to_int(.line_number)
  if err == null {
    .event.sequence = _result
  } else {
    log("[powershell_history] échec de l'opération to_int sur event.sequence : " + err, level: "warn")
  }
}

# [normalization] line_number -> labels.line_number
if exists(.line_number) {
  .labels.line_number = .line_number
}

# [deletion] type, line_number, command
del(.type)
del(.line_number)
del(.command)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.process.command_line) {
  .message = "PowerShell command was executed: " + to_string!(.process.command_line)
}
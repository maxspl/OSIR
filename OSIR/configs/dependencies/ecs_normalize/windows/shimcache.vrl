##############################################################
# Module VRL : shimcache
# Version    : 1.0
# Windows ShimCache / AppCompatCache (AppCompatCacheParser CSV) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."file.path") {
  .file.path = get!(., path: ["file.path"])
  del(."file.path")
}
if exists(."labels.executed") {
  .labels.executed = get!(., path: ["labels.executed"])
  del(."labels.executed")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
.event.original = encode_json!(.)

# [normalization] windows.shimcache -> event.dataset
.event.dataset = "windows.shimcache"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['file'] -> event.category
.event.category = ["file"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [normalization] Windows AppCompatCache (ShimCache) -> event.provider
.event.provider = "Windows AppCompatCache (ShimCache)"

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] Path -> file.path
if exists(.Path) && exists(.CacheEntryPosition) {
  .file.path = .Path
}

# [normalization] LastModifiedTimeUTC -> file.mtime
if exists(.Path) && exists(.CacheEntryPosition) && exists(.LastModifiedTimeUTC) {
  _result, err = parse_timestamp(.LastModifiedTimeUTC, format: "%F %T")
  if err == null {
    .file.mtime = _result
  } else {
    log("[shimcache] échec de l'opération parse_timestamp sur file.mtime : " + err, level: "warn")
  }
}

# [normalization] LastModifiedTimeUTC -> timestamp
if exists(.Path) && exists(.CacheEntryPosition) && exists(.LastModifiedTimeUTC) {
  _result, err = parse_timestamp(.LastModifiedTimeUTC, format: "%F %T")
  if err == null {
    .timestamp = _result
  } else {
    log("[shimcache] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] ControlSet -> labels.control_set
if exists(.Path) && exists(.CacheEntryPosition) && exists(.ControlSet) {
  _result, err = to_int(.ControlSet)
  if err == null {
    .labels.control_set = _result
  } else {
    log("[shimcache] échec de l'opération to_int sur labels.control_set : " + err, level: "warn")
  }
}

# [normalization] CacheEntryPosition -> labels.cache_entry_position
if exists(.Path) && exists(.CacheEntryPosition) {
  _result, err = to_int(.CacheEntryPosition)
  if err == null {
    .labels.cache_entry_position = _result
  } else {
    log("[shimcache] échec de l'opération to_int sur labels.cache_entry_position : " + err, level: "warn")
  }
}

# [normalization] Executed -> labels.executed
if exists(.Path) && exists(.CacheEntryPosition) && exists(.Executed) {
  _result, err = to_bool(.Executed)
  if err == null {
    .labels.executed = _result
  } else {
    log("[shimcache] échec de l'opération to_bool sur labels.executed : " + err, level: "warn")
  }
}

# [normalization] Duplicate -> labels.duplicate
if exists(.Path) && exists(.CacheEntryPosition) && exists(.Duplicate) {
  _result, err = to_bool(.Duplicate)
  if err == null {
    .labels.duplicate = _result
  } else {
    log("[shimcache] échec de l'opération to_bool sur labels.duplicate : " + err, level: "warn")
  }
}

# [normalization] SourceFile -> labels.source_file
if exists(.Path) && exists(.CacheEntryPosition) && exists(.SourceFile) {
  .labels.source_file = .SourceFile
}

# [deletion] ControlSet, CacheEntryPosition, Path, LastModifiedTimeUTC, Executed, Duplicate, SourceFile
del(.ControlSet)
del(.CacheEntryPosition)
del(.Path)
del(.LastModifiedTimeUTC)
del(.Executed)
del(.Duplicate)
del(.SourceFile)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.file.path) {
  .message = "ShimCache entry exists for " + to_string!(.file.path)
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.file.path), "target": to_string!(.labels.executed), "type": "executed"})
}
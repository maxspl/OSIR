##############################################################
# Module VRL : netstat
# Version    : 1.0
# Windows netstat → ECS only
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json(.) -> event.original
.event.original = encode_json(.)

# [normalization] windows.netstat -> event.dataset
.event.dataset = "windows.netstat"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['network'] -> event.category
.event.category = ["network"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [custom]
if exists(.type) {
    t = to_string(del(.type)) ?? ""
    .event.code   = t
    .event.action = downcase(t)
}

if exists(.protocol) {
    proto_raw = to_string(del(.protocol)) ?? ""
    proto_l   = downcase(proto_raw)

    .network.transport = proto_l
    .network.protocol  = proto_l
}

if exists(.state) {
    state_raw = to_string(del(.state)) ?? ""
    .network.state = state_raw
}

if exists(.network.state) {
    s = downcase(to_string(.network.state) ?? "")

    if s == "listening" {
        .network.direction = "ingress"
    }
}

if exists(.pid) {
    pid_raw = to_string(del(.pid)) ?? ""
    pid_i   = to_int(pid_raw) ?? null

    .process.pid = pid_i
}

if exists(.local_address) {
    raw = to_string(del(.local_address)) ?? ""
    raw = replace(raw, "[","")
    raw = replace(raw, "]","")

    parts = split(raw, ":")

    if length(parts) >= 2 {
        ip_parts = slice!(parts, 0, length(parts) - 1)
        ip = join!(ip_parts, ":")
        port_s = parts[-1]
        port_i = to_int(port_s) ?? null

        .source.ip   = ip
        .source.port = port_i

        .source.address = raw
    }
}

if exists(.remote_address) {
    raw = to_string(del(.remote_address)) ?? ""
    raw = replace(raw, "[","")
    raw = replace(raw, "]","")


    parts = split(raw, ":")

    if length(parts) >= 2 {
        ip_parts = slice!(parts, 0, length(parts) - 1)
        ip = join!(ip_parts, ":")
        port_s = parts[-1]
        port_i = to_int(port_s) ?? null

        .destination.ip   = ip
        .destination.port = port_i

        .destination.address = raw
    }
}

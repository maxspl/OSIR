##############################################################
# Module VRL : arp_cache
# Version    : 1.0
# Windows ARP Cache
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [custom]
if !exists(.event) || !exists(.event.original) {
    .event.original = encode_json!(.)
}

# [normalization] windows.arp_cache -> event.dataset
.event.dataset = "windows.arp_cache"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] state -> event.kind
.event.kind = "state"

# [normalization] ['network'] -> event.category
.event.category = ["network"]

# [normalization] ['info', 'arp'] -> event.type
.event.type = ["info", "arp"]

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] Windows ARP Cache -> event.provider
.event.provider = "Windows ARP Cache"

# [normalization] arp -> network.protocol
.network.protocol = "arp"

# [normalization] ipv4 -> network.type
.network.type = "ipv4"

# [custom]
rec_type = null

if exists(.type) {
    rec_type = to_string!(del(.type))
    .event.code   = rec_type
    .event.action = downcase(rec_type)
}

if exists(.interface_ip) {
    iface_ip = to_string!(del(.interface_ip))

    .source.ip = iface_ip
    .network.Ext.arp.interface_ip = iface_ip

    .host.ip = [iface_ip]
}

# [normalization] to_string!(del(.interface_index)) -> network.Ext.arp.interface_index
if exists(.interface_index) {
  .network.Ext.arp.interface_index = to_string!(del(.interface_index))
}

# [custom]
if exists(.ip_address) {
    neigh_ip = to_string!(del(.ip_address))
    .destination.ip = neigh_ip
    .network.Ext.arp.neighbor_ip = neigh_ip

    ip_str = neigh_ip
    if contains(ip_str, ":") {
        .network.type = "ipv6"
    } else {
        .network.type = "ipv4"
    }
}

if exists(.mac_address) {
    mac_raw = to_string!(del(.mac_address))
    .network.Ext.arp.neighbor_mac_raw = mac_raw

    mac_norm = downcase(replace(mac_raw, "-", ":"))
    .network.Ext.arp.neighbor_mac = mac_norm

    .destination.mac = mac_norm
}

if exists(.entry_type) {
    et_raw = to_string!(del(.entry_type))
    et_l   = downcase(et_raw)

    .network.Ext.arp.entry_type_raw = et_raw

    norm = et_l
    if et_l == "dynamique" {
        norm = "dynamic"
    } else if et_l == "statique" {
        norm = "static"
    }

    .network.Ext.arp.entry_type = norm
}

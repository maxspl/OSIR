##############################################################
# Module VRL : loki
# Version    : 1.0
# Loki-RS ECS normalization
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."event.severity") {
  .event.severity = get!(., path: ["event.severity"])
  del(."event.severity")
}
if exists(."log.level") {
  .log.level = get!(., path: ["log.level"])
  del(."log.level")
}
if exists(."event.kind") {
  .event.kind = get!(., path: ["event.kind"])
  del(."event.kind")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
if !exists(.event.original) {
  .event.original = encode_json!(.)
}

# [normalization] loki -> event.module
.event.module = "loki"

# [normalization] Nextron Systems -> observer.vendor
.observer.vendor = "Nextron Systems"

# [normalization] Loki-RS -> observer.product
.observer.product = "Loki-RS"

# [normalization] scanner -> observer.type
.observer.type = "scanner"

# [normalization] format_timestamp!(parse_timestamp!(to_string!(.timestamp), format: "%+"), format: "%Y-%m-%dT%H:%M:%SZ") -> timestamp
if (parse_timestamp(to_string!(.timestamp), format: "%+") ?? null) != null && exists(.timestamp) {
  .timestamp = format_timestamp!(parse_timestamp!(to_string!(.timestamp), format: "%+"), format: "%Y-%m-%dT%H:%M:%SZ")
}

# [normalization] to_string!(.hostname) -> observer.hostname
if exists(.hostname) && (to_string(.hostname) ?? "") != "" {
  .observer.hostname = to_string!(.hostname)
}

# [normalization] downcase!(to_string!(.level)) -> log.level
if exists(.level) {
  .log.level = downcase!(to_string!(.level))
}

# [normalization] 90 -> event.severity
if .log.level == "alert" {
  .event.severity = 90
}

# [normalization] 70 -> event.severity
if .log.level == "warning" {
  .event.severity = 70
}

# [normalization] 50 -> event.severity
if .log.level == "notice" {
  .event.severity = 50
}

# [normalization] 40 -> event.severity
if .log.level == "error" {
  .event.severity = 40
}

# [normalization] 10 -> event.severity
if !exists(.event.severity) && exists(.log.level) {
  .event.severity = 10
}

# [normalization] to_string(.message) ?? null -> message
if exists(.message) {
  .message = to_string(.message) ?? null
}

# [normalization] to_int(to_float(.score) ?? 0.0) -> event.risk_score
if exists(.score) && (to_float(.score) ?? null) != null {
  .event.risk_score = to_int(to_float(.score) ?? 0.0)
}

# [normalization] to_int(to_float(.score) ?? 0.0) -> loki.score
if exists(.score) && (to_float(.score) ?? null) != null {
  .loki.score = to_int(to_float(.score) ?? 0.0)
}

# [normalization] downcase(to_string(.event_type) ?? "info") -> event_type_lower
if exists(.event_type) {
  .event_type_lower = downcase(to_string(.event_type) ?? "info")
}

# [normalization] alert -> event.kind
if .event_type_lower == "file_match" {
  .event.kind = "alert"
}

# [normalization] ['file', 'malware'] -> event.category
if .event_type_lower == "file_match" {
  .event.category = ["file", "malware"]
}

# [normalization] ['info'] -> event.type
if .event_type_lower == "file_match" {
  .event.type = ["info"]
}

# [normalization] loki-file-match -> event.action
if .event_type_lower == "file_match" {
  .event.action = "loki-file-match"
}

# [normalization] loki.filescan -> event.dataset
if .event_type_lower == "file_match" {
  .event.dataset = "loki.filescan"
}

# [normalization] alert -> event.kind
if .event_type_lower == "process_match" {
  .event.kind = "alert"
}

# [normalization] ['process', 'malware'] -> event.category
if .event_type_lower == "process_match" {
  .event.category = ["process", "malware"]
}

# [normalization] ['info'] -> event.type
if .event_type_lower == "process_match" {
  .event.type = ["info"]
}

# [normalization] loki-process-match -> event.action
if .event_type_lower == "process_match" {
  .event.action = "loki-process-match"
}

# [normalization] loki.processcheck -> event.dataset
if .event_type_lower == "process_match" {
  .event.dataset = "loki.processcheck"
}

# [normalization] event -> event.kind
if .event_type_lower == "scan_start" {
  .event.kind = "event"
}

# [normalization] ['process'] -> event.category
if .event_type_lower == "scan_start" {
  .event.category = ["process"]
}

# [normalization] ['start'] -> event.type
if .event_type_lower == "scan_start" {
  .event.type = ["start"]
}

# [normalization] loki-scan-start -> event.action
if .event_type_lower == "scan_start" {
  .event.action = "loki-scan-start"
}

# [normalization] loki.scan -> event.dataset
if .event_type_lower == "scan_start" {
  .event.dataset = "loki.scan"
}

# [normalization] event -> event.kind
if .event_type_lower == "scan_end" {
  .event.kind = "event"
}

# [normalization] ['process'] -> event.category
if .event_type_lower == "scan_end" {
  .event.category = ["process"]
}

# [normalization] ['end'] -> event.type
if .event_type_lower == "scan_end" {
  .event.type = ["end"]
}

# [normalization] loki-scan-end -> event.action
if .event_type_lower == "scan_end" {
  .event.action = "loki-scan-end"
}

# [normalization] loki.scan -> event.dataset
if .event_type_lower == "scan_end" {
  .event.dataset = "loki.scan"
}

# [normalization] event -> event.kind
if .event_type_lower == "error" {
  .event.kind = "event"
}

# [normalization] ['process'] -> event.category
if .event_type_lower == "error" {
  .event.category = ["process"]
}

# [normalization] ['error'] -> event.type
if .event_type_lower == "error" {
  .event.type = ["error"]
}

# [normalization] loki-scan-error -> event.action
if .event_type_lower == "error" {
  .event.action = "loki-scan-error"
}

# [normalization] loki.scan -> event.dataset
if .event_type_lower == "error" {
  .event.dataset = "loki.scan"
}

# [normalization] event -> event.kind
if !exists(.event.kind) {
  .event.kind = "event"
}

# [normalization] ['process'] -> event.category
if !exists(.event.kind) {
  .event.category = ["process"]
}

# [normalization] ['info'] -> event.type
if !exists(.event.kind) {
  .event.type = ["info"]
}

# [normalization] loki-scan-info -> event.action
if !exists(.event.kind) {
  .event.action = "loki-scan-info"
}

# [normalization] loki.scan -> event.dataset
if !exists(.event.kind) {
  .event.dataset = "loki.scan"
}

# [deletion] event_type_lower
del(.event_type_lower)

# [normalization] to_string(.file_path) ?? null -> file.path
if exists(.file_path) && (to_string(.file_path) ?? "") != "" {
  .file.path = to_string(.file_path) ?? null
}

# [normalization] basename!(to_string!(.file_path)) -> file.name
if exists(.file_path) && (to_string(.file_path) ?? "") != "" {
  .file.name = basename!(to_string!(.file_path))
}

# [normalization] downcase!(to_string!(split(basename!(to_string!(.file_path)), ".")[-1])) -> file.extension
if exists(.file_path) && (to_string(.file_path) ?? "") != "" && length(split(basename!(to_string!(.file_path)), ".")) > 1 {
  .file.extension = downcase!(to_string!(split(basename!(to_string!(.file_path)), ".")[-1]))
}

# [normalization] to_string(.file_type) ?? null -> file.type
if exists(.file_type) {
  .file.type = to_string(.file_type) ?? null
}

# [normalization] to_int(.file_size) ?? null -> file.size
if exists(.file_size) && (to_int(.file_size) ?? null) != null {
  .file.size = to_int(.file_size) ?? null
}

# [normalization] to_string(.md5) ?? null -> file.hash.md5
if exists(.md5) {
  .file.hash.md5 = to_string(.md5) ?? null
}

# [normalization] to_string(.sha1) ?? null -> file.hash.sha1
if exists(.sha1) {
  .file.hash.sha1 = to_string(.sha1) ?? null
}

# [normalization] to_string(.sha256) ?? null -> file.hash.sha256
if exists(.sha256) {
  .file.hash.sha256 = to_string(.sha256) ?? null
}

# [normalization] to_string(.file_created) ?? null -> file.created
if exists(.file_created) {
  .file.created = to_string(.file_created) ?? null
}

# [normalization] to_string(.file_modified) ?? null -> file.mtime
if exists(.file_modified) {
  .file.mtime = to_string(.file_modified) ?? null
}

# [normalization] to_string(.file_accessed) ?? null -> file.accessed
if exists(.file_accessed) {
  .file.accessed = to_string(.file_accessed) ?? null
}

# [normalization] to_int(.pid) ?? null -> process.pid
if exists(.pid) && (to_int(.pid) ?? null) != null {
  .process.pid = to_int(.pid) ?? null
}

# [normalization] to_string(.process_name) ?? null -> process.name
if exists(.process_name) {
  .process.name = to_string(.process_name) ?? null
}

# [normalization] format_timestamp!(from_unix_timestamp!(to_int!(.start_time)), format: "%Y-%m-%dT%H:%M:%SZ") -> process.start
if exists(.start_time) && (to_int(.start_time) ?? null) != null {
  .process.start = format_timestamp!(from_unix_timestamp!(to_int!(.start_time)), format: "%Y-%m-%dT%H:%M:%SZ")
}

# [normalization] to_string(.run_time) ?? null -> loki.process.run_time
if exists(.run_time) {
  .loki.process.run_time = to_string(.run_time) ?? null
}

# [normalization] to_int(.memory_bytes) ?? null -> loki.process.memory_bytes
if exists(.memory_bytes) && (to_int(.memory_bytes) ?? null) != null {
  .loki.process.memory_bytes = to_int(.memory_bytes) ?? null
}

# [normalization] to_float(.cpu_usage) ?? null -> loki.process.cpu_usage
if exists(.cpu_usage) && (to_float(.cpu_usage) ?? null) != null {
  .loki.process.cpu_usage = to_float(.cpu_usage) ?? null
}

# [normalization] to_int(.connection_count) ?? null -> loki.process.connection_count
if exists(.connection_count) && (to_int(.connection_count) ?? null) != null {
  .loki.process.connection_count = to_int(.connection_count) ?? null
}

# [normalization] listening_ports -> loki.process.listening_ports
if exists(.listening_ports) {
  .loki.process.listening_ports = .listening_ports
}

# [custom]
if exists(.reasons) {
    reasons = array(.reasons) ?? []
    .loki.reasons_count = length(reasons)

    if length(reasons) > 0 {
        primary = object(reasons[0]) ?? {}

        if exists(primary.message) {
            reason_message = to_string(primary.message) ?? ""
            .event.reason = reason_message

            if starts_with(reason_message, "YARA match with rule ") {
                .rule.name = replace(reason_message, "YARA match with rule ", "")
                .rule.ruleset = "yara"
            } else if starts_with(reason_message, "HASH match with IOC HASH: ") {
                .rule.name = replace(reason_message, "HASH match with IOC HASH: ", "")
                .rule.ruleset = "hash_ioc"
            } else if starts_with(reason_message, "File Name IOC matched PATTERN: ") {
                .rule.name = replace(reason_message, "File Name IOC matched PATTERN: ", "")
                .rule.ruleset = "filename_ioc"
            } else {
                .rule.name = reason_message
                .rule.ruleset = "loki"
            }
        }

        if exists(primary.score) {
            primary_score = to_int(primary.score) ?? null
            if primary_score != null {
                .rule.risk_score = primary_score
            }
        }

        if exists(primary.description) {
            .rule.description = to_string(primary.description) ?? null
        }

        if exists(primary.author) {
            .rule.author = [to_string!(primary.author)]
        }

        if exists(primary.reference) {
            .rule.reference = to_string(primary.reference) ?? null
        }

        if exists(primary.matched_strings) {
            .loki.primary.matched_strings = primary.matched_strings
        }
    }

    .loki.reasons = reasons
}

# [normalization] context -> loki.context
if exists(.context) {
  .loki.context = .context
}

# [deletion] hostname, level, event_type, score, file_path, file_type, file_size, md5, sha1, sha256, file_created, file_modified, file_accessed, pid, process_name, start_time, run_time, memory_bytes, cpu_usage, connection_count, listening_ports, reasons, context
del(.hostname)
del(.level)
del(.event_type)
del(.score)
del(.file_path)
del(.file_type)
del(.file_size)
del(.md5)
del(.sha1)
del(.sha256)
del(.file_created)
del(.file_modified)
del(.file_accessed)
del(.pid)
del(.process_name)
del(.start_time)
del(.run_time)
del(.memory_bytes)
del(.cpu_usage)
del(.connection_count)
del(.listening_ports)
del(.reasons)
del(.context)

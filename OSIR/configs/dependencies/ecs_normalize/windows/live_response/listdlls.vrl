##############################################################
# Module VRL : listdlls
# Version    : 1.0
# Sysinternals ListDLLs → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [custom]
if !exists(.event) || !exists(.event.original) {
    .event.original = encode_json!(.)
}

# [normalization] windows.listdlls -> event.dataset
.event.dataset = "windows.listdlls"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['process'] -> event.category
.event.category = ["process"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] Sysinternals ListDLLs -> event.provider
.event.provider = "Sysinternals ListDLLs"

# [custom]
if exists(.type) {
    type_raw = to_string!(del(.type))
    type_l   = downcase(type_raw)

    .event.code   = type_raw
    .event.action = type_l
}

# [normalization] del(.process_name) -> process.name
if exists(.process_name) {
  .process.name = del(.process_name)
}

# [custom]
if exists(.pid) {
    pid_raw = to_string!(del(.pid))
    pid_int = parse_int(pid_raw) ?? null

    if pid_int != null {
        .process.pid = pid_int
    } else {
        .process.pid = pid_raw
    }
}

if exists(.path) {
    dll_path = to_string!(del(.path))

    .dll.path  = dll_path
    .file.path = dll_path

    dll_path_norm = replace(dll_path, "\\", "/")

    dll_name = basename(dll_path_norm) ?? null

    if dll_name != null {
        .dll.name  = dll_name
        .file.name = dll_name
    }

    if exists(.process.name) {
        proc_name  = to_string!(.process.name)
        dll_lower  = downcase(dll_path)
        proc_lower = downcase(proc_name)

        if ends_with(dll_lower, "\\" + proc_lower) || ends_with(dll_lower, "/" + proc_lower) {
            .process.executable = dll_path
        }
    }
}

# [normalization] to_string!(del(.base_address)) -> dll.Ext.base_address
if exists(.base_address) {
  .dll.Ext.base_address = to_string!(del(.base_address))
}

# [custom]
if exists(.size) {
    size_raw = to_string!(del(.size))
    size_int = parse_int(size_raw) ?? null

    if size_int != null {
        .dll.Ext.memory_size = size_int
    } else {
        .dll.Ext.memory_size = size_raw
    }
}

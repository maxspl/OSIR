##############################################################
# Module VRL : mactime
# Version    : 1.0
# osir-mactime | Osir Transform description to normalize Mactime log file.
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."file.name") {
  .file.name = get!(., path: ["file.name"])
  del(."file.name")
}
if exists(."event.action") {
  .event.action = get!(., path: ["event.action"])
  del(."event.action")
}
if exists(."file.size") {
  .file.size = get!(., path: ["file.size"])
  del(."file.size")
}
if exists(."file.mode") {
  .file.mode = get!(., path: ["file.mode"])
  del(."file.mode")
}
if exists(."file.uid") {
  .file.uid = get!(., path: ["file.uid"])
  del(."file.uid")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] to_string!(.Date) -> timestamp
if exists(.Date) {
  .timestamp = to_string!(.Date)
}

# [normalization] to_int!(.Size) -> file.size
if exists(.Size) {
  .file.size = to_int!(.Size)
}

# [normalization] to_string!(.Mode) -> file.mode
if exists(.Mode) {
  .file.mode = to_string!(.Mode)
}

# [normalization] to_int!(.UID) -> file.uid
if exists(.UID) {
  .file.uid = to_int!(.UID)
}

# [normalization] to_int!(.GID) -> file.gid
if exists(.GID) {
  .file.gid = to_int!(.GID)
}

# [normalization] get!(., path: ["File Name"]) -> file.name
.file.name = get!(., path: ["File Name"])

# [normalization] to_string!(.Meta) -> file.meta
if exists(.Meta) {
  .file.meta = to_string!(.Meta)
}

# [translation] Type -> event.action
if exists(.Type) {
  .event.action = get(value: {
  "...b": "Created",
  ".a.b": "Created",
  ".acb": "Created",
  ".ab.": "Created",
  "m..b": "Created",
  "ma.b": "Created",
  "macb": "Created",
  "m.cb": "Created",
  "..cb": "Created",
  "..c.": "Created",
  ".ac.": "Created",
  "m.c.": "Created",
  "mac.": "Created",
  "m...": "Modified",
  "ma..": "Modified",
  ".a..": "Accessed",
  "....": "No activity recorded",
}, path: [to_string!(.Type)]) ?? "Unknown"
}

# [deletion] Date, Size, Type, Mode, UID, GID, Meta, File Name
del(.Date)
del(.Size)
del(.Type)
del(.Mode)
del(.UID)
del(.GID)
del(.Meta)
del(."File Name")

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.file.name) && exists(.event.action) {
  .message = to_string!(.file.name) + " — " + to_string!(.event.action)
}
if exists(.file.size) && exists(.file.name) && exists(.event.action) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes) — " + to_string!(.event.action)
}
if .event.action == "No activity recorded" && exists(.file.name) {
  .message = to_string!(.file.name) + " — No activity recorded"
}
if exists(.file.size) && exists(.file.mode) && .event.action == "Created" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Created"
}
if exists(.file.size) && exists(.file.mode) && .event.action == "Modified" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Modified"
}
if exists(.file.size) && exists(.file.mode) && .event.action == "Accessed" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Accessed"
}
if exists(.file.size) && exists(.file.mode) && exists(.file.uid) && .event.action == "Created" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Created by uid " + to_string!(.file.uid)
}
if exists(.file.size) && exists(.file.mode) && exists(.file.uid) && .event.action == "Modified" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Modified by uid " + to_string!(.file.uid)
}
if exists(.file.size) && exists(.file.mode) && exists(.file.uid) && .event.action == "Accessed" && exists(.file.name) {
  .message = to_string!(.file.name) + " (" + to_string!(.file.size) + " bytes, mode " + to_string!(.file.mode) + ") — Accessed by uid " + to_string!(.file.uid)
}
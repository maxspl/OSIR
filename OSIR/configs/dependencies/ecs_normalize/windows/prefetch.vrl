##############################################################
# Module VRL : prefetch
# Version    : 1.0
# Windows Prefetch JSONL (PECmd) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."process.name") {
  .process.name = get!(., path: ["process.name"])
  del(."process.name")
}
if exists(."file.path") {
  .file.path = get!(., path: ["file.path"])
  del(."file.path")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
.event.original = encode_json!(.)

# [normalization] windows.prefetch -> event.dataset
.event.dataset = "windows.prefetch"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['process'] -> event.category
.event.category = ["process"]

# [normalization] ['start', 'info'] -> event.type
.event.type = ["start", "info"]

# [normalization] Windows Prefetch -> event.provider
.event.provider = "Windows Prefetch"

# [normalization] prefetch_entry -> event.action
.event.action = "prefetch_entry"

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] SourceFilename -> file.path
if exists(.SourceFilename) {
  .file.path = .SourceFilename
}

# [normalization] ExecutableName -> process.name
if exists(.ExecutableName) {
  .process.name = .ExecutableName
}

# [normalization] Hash -> labels.hash
if exists(.Hash) {
  .labels.hash = .Hash
}

# [normalization] Version -> labels.version
if exists(.Version) {
  .labels.version = .Version
}

# [normalization] LastRun -> timestamp
if exists(.LastRun) {
  _result, err = parse_timestamp(.LastRun, format: "%F %T")
  if err == null {
    .timestamp = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] LastRun -> event.start
if exists(.LastRun) {
  _result, err = parse_timestamp(.LastRun, format: "%F %T")
  if err == null {
    .event.start = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur event.start : " + err, level: "warn")
  }
}

# [normalization] LastRun -> labels.last_run
if exists(.LastRun) {
  _result, err = parse_timestamp(.LastRun, format: "%F %T")
  if err == null {
    .labels.last_run = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.last_run : " + err, level: "warn")
  }
}

# [normalization] SourceCreated -> file.created
if exists(.SourceCreated) {
  _result, err = parse_timestamp(.SourceCreated, format: "%F %T")
  if err == null {
    .file.created = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur file.created : " + err, level: "warn")
  }
}

# [normalization] SourceModified -> file.mtime
if exists(.SourceModified) {
  _result, err = parse_timestamp(.SourceModified, format: "%F %T")
  if err == null {
    .file.mtime = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur file.mtime : " + err, level: "warn")
  }
}

# [normalization] SourceAccessed -> file.accessed
if exists(.SourceAccessed) {
  _result, err = parse_timestamp(.SourceAccessed, format: "%F %T")
  if err == null {
    .file.accessed = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur file.accessed : " + err, level: "warn")
  }
}

# [normalization] Size -> file.size
if exists(.Size) {
  _result, err = to_int(.Size)
  if err == null {
    .file.size = _result
  } else {
    log("[prefetch] échec de l'opération to_int sur file.size : " + err, level: "warn")
  }
}

# [normalization] RunCount -> labels.run_count
if exists(.RunCount) {
  _result, err = to_int(.RunCount)
  if err == null {
    .labels.run_count = _result
  } else {
    log("[prefetch] échec de l'opération to_int sur labels.run_count : " + err, level: "warn")
  }
}

# [normalization] PreviousRun0 -> labels.previous_run0
if exists(.PreviousRun0) {
  _result, err = parse_timestamp(.PreviousRun0, format: "%F %T")
  if err == null {
    .labels.previous_run0 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run0 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun1 -> labels.previous_run1
if exists(.PreviousRun1) {
  _result, err = parse_timestamp(.PreviousRun1, format: "%F %T")
  if err == null {
    .labels.previous_run1 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run1 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun2 -> labels.previous_run2
if exists(.PreviousRun2) {
  _result, err = parse_timestamp(.PreviousRun2, format: "%F %T")
  if err == null {
    .labels.previous_run2 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run2 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun3 -> labels.previous_run3
if exists(.PreviousRun3) {
  _result, err = parse_timestamp(.PreviousRun3, format: "%F %T")
  if err == null {
    .labels.previous_run3 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run3 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun4 -> labels.previous_run4
if exists(.PreviousRun4) {
  _result, err = parse_timestamp(.PreviousRun4, format: "%F %T")
  if err == null {
    .labels.previous_run4 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run4 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun5 -> labels.previous_run5
if exists(.PreviousRun5) {
  _result, err = parse_timestamp(.PreviousRun5, format: "%F %T")
  if err == null {
    .labels.previous_run5 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run5 : " + err, level: "warn")
  }
}

# [normalization] PreviousRun6 -> labels.previous_run6
if exists(.PreviousRun6) {
  _result, err = parse_timestamp(.PreviousRun6, format: "%F %T")
  if err == null {
    .labels.previous_run6 = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.previous_run6 : " + err, level: "warn")
  }
}

# [normalization] Volume0Name -> labels.volume0_name
if exists(.Volume0Name) {
  .labels.volume0_name = .Volume0Name
}

# [normalization] Volume0Serial -> labels.volume0_serial
if exists(.Volume0Serial) {
  .labels.volume0_serial = .Volume0Serial
}

# [normalization] Volume1Name -> labels.volume1_name
if exists(.Volume1Name) {
  .labels.volume1_name = .Volume1Name
}

# [normalization] Volume1Serial -> labels.volume1_serial
if exists(.Volume1Serial) {
  .labels.volume1_serial = .Volume1Serial
}

# [normalization] Volume0Created -> labels.volume0_created
if exists(.Volume0Created) {
  _result, err = parse_timestamp(.Volume0Created, format: "%F %T")
  if err == null {
    .labels.volume0_created = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.volume0_created : " + err, level: "warn")
  }
}

# [normalization] Volume1Created -> labels.volume1_created
if exists(.Volume1Created) {
  _result, err = parse_timestamp(.Volume1Created, format: "%F %T")
  if err == null {
    .labels.volume1_created = _result
  } else {
    log("[prefetch] échec de l'opération parse_timestamp sur labels.volume1_created : " + err, level: "warn")
  }
}

# [normalization] Directories -> labels.directories
if exists(.Directories) {
  _result, err = split(.Directories, pattern: ", ")
  if err == null {
    .labels.directories = _result
  } else {
    log("[prefetch] échec de l'opération split sur labels.directories : " + err, level: "warn")
  }
}

# [normalization] FilesLoaded -> labels.files_loaded
if exists(.FilesLoaded) {
  _result, err = split(.FilesLoaded, pattern: ", ")
  if err == null {
    .labels.files_loaded = _result
  } else {
    log("[prefetch] échec de l'opération split sur labels.files_loaded : " + err, level: "warn")
  }
}

# [deletion] SourceFilename, SourceCreated, SourceModified, SourceAccessed, ExecutableName, Hash, Size, Version, RunCount, LastRun, PreviousRun0, PreviousRun1, PreviousRun2, PreviousRun3, PreviousRun4, PreviousRun5, PreviousRun6, Volume0Name, Volume0Serial, Volume0Created, Volume1Name, Volume1Serial, Volume1Created, Directories, FilesLoaded, ParsingError
del(.SourceFilename)
del(.SourceCreated)
del(.SourceModified)
del(.SourceAccessed)
del(.ExecutableName)
del(.Hash)
del(.Size)
del(.Version)
del(.RunCount)
del(.LastRun)
del(.PreviousRun0)
del(.PreviousRun1)
del(.PreviousRun2)
del(.PreviousRun3)
del(.PreviousRun4)
del(.PreviousRun5)
del(.PreviousRun6)
del(.Volume0Name)
del(.Volume0Serial)
del(.Volume0Created)
del(.Volume1Name)
del(.Volume1Serial)
del(.Volume1Created)
del(.Directories)
del(.FilesLoaded)
del(.ParsingError)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.process.name) && exists(.timestamp) {
  .message = "Program " + to_string!(.process.name) + " was executed (last run " + to_string!(.timestamp) + ")"
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.process.name), "target": to_string!(.file.path), "type": "recorded in"})
}
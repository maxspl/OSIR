# [custom]
ns = []

if exists(."Ns[0].Name") {
    ns0 = {
        "name": del(."Ns[0].Name"),
        "value": del(."Ns[0].Value")
    }
    ns = push(ns, ns0)
}

if exists(."Ns[1].Name") {
    ns1 = {
        "name": del(."Ns[1].Name"),
        "value": del(."Ns[1].Value")
    }

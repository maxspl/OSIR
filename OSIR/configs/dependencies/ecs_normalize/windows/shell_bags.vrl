##############################################################
# Module VRL : shell_bags
# Version    : 1.0
# Windows ShellBags CSV (SBECmd) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."labels.shell_type") {
  .labels.shell_type = get!(., path: ["labels.shell_type"])
  del(."labels.shell_type")
}
if exists(."labels.has_explored") {
  .labels.has_explored = get!(., path: ["labels.has_explored"])
  del(."labels.has_explored")
}
if exists(."user.name") {
  .user.name = get!(., path: ["user.name"])
  del(."user.name")
}
if exists(."labels.absolute_path") {
  .labels.absolute_path = get!(., path: ["labels.absolute_path"])
  del(."labels.absolute_path")
}
if exists(."labels.value") {
  .labels.value = get!(., path: ["labels.value"])
  del(."labels.value")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] LastWriteTime -> timestamp
if exists(.LastWriteTime) && .LastWriteTime != "" {
  _result, err = parse_timestamp(.LastWriteTime, format: "%F %T%.f")
  if err == null {
    .timestamp = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] FirstInteracted -> timestamp
if exists(.FirstInteracted) && .FirstInteracted != "" {
  _result, err = parse_timestamp(.FirstInteracted, format: "%F %T%.f")
  if err == null {
    .timestamp = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] LastInteracted -> timestamp
if exists(.LastInteracted) && .LastInteracted != "" {
  _result, err = parse_timestamp(.LastInteracted, format: "%F %T%.f")
  if err == null {
    .timestamp = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] BagPath -> labels.bag_path
if exists(.BagPath) {
  .labels.bag_path = .BagPath
}

# [normalization] AbsolutePath -> labels.absolute_path
if exists(.AbsolutePath) {
  .labels.absolute_path = .AbsolutePath
}

# [normalization] ShellType -> labels.shell_type
if exists(.ShellType) {
  .labels.shell_type = .ShellType
}

# [normalization] Value -> labels.value
if exists(.Value) {
  .labels.value = .Value
}

# [normalization] Miscellaneous -> labels.misc
if exists(.Miscellaneous) && .Miscellaneous != "" {
  .labels.misc = .Miscellaneous
}

# [normalization] Value -> file.name
if .labels.shell_type == "File" && exists(.Value) {
  .file.name = .Value
}

# [normalization] Value -> file.directory
if .labels.shell_type == "Directory" && exists(.Value) {
  .file.directory = .Value
}

# [normalization] Slot -> labels.slot
if exists(.Slot) {
  _result, err = to_int(.Slot)
  if err == null {
    .labels.slot = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.slot : " + err, level: "warn")
  }
}

# [normalization] NodeSlot -> labels.node_slot
if exists(.NodeSlot) {
  _result, err = to_int(.NodeSlot)
  if err == null {
    .labels.node_slot = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.node_slot : " + err, level: "warn")
  }
}

# [normalization] MRUPosition -> labels.mru_position
if exists(.MRUPosition) {
  _result, err = to_int(.MRUPosition)
  if err == null {
    .labels.mru_position = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.mru_position : " + err, level: "warn")
  }
}

# [normalization] ChildBags -> labels.child_bags
if exists(.ChildBags) {
  _result, err = to_int(.ChildBags)
  if err == null {
    .labels.child_bags = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.child_bags : " + err, level: "warn")
  }
}

# [normalization] MFTSequenceNumber -> labels.mft_sequence
if exists(.MFTSequenceNumber) {
  _result, err = to_int(.MFTSequenceNumber)
  if err == null {
    .labels.mft_sequence = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.mft_sequence : " + err, level: "warn")
  }
}

# [normalization] ExtensionBlockCount -> labels.extension_block_count
if exists(.ExtensionBlockCount) {
  _result, err = to_int(.ExtensionBlockCount)
  if err == null {
    .labels.extension_block_count = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur labels.extension_block_count : " + err, level: "warn")
  }
}

# [normalization] HasExplored -> labels.has_explored
if exists(.HasExplored) {
  _result, err = to_bool(.HasExplored)
  if err == null {
    .labels.has_explored = _result
  } else {
    log("[shell_bags] échec de l'opération to_bool sur labels.has_explored : " + err, level: "warn")
  }
}

# [normalization] LastWriteTime -> labels.last_write_time
if exists(.LastWriteTime) {
  _result, err = parse_timestamp(.LastWriteTime, format: "%F %T%.f")
  if err == null {
    .labels.last_write_time = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur labels.last_write_time : " + err, level: "warn")
  }
}

# [normalization] FirstInteracted -> labels.first_interacted
if exists(.FirstInteracted) {
  _result, err = parse_timestamp(.FirstInteracted, format: "%F %T%.f")
  if err == null {
    .labels.first_interacted = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur labels.first_interacted : " + err, level: "warn")
  }
}

# [normalization] LastInteracted -> labels.last_interacted
if exists(.LastInteracted) {
  _result, err = parse_timestamp(.LastInteracted, format: "%F %T%.f")
  if err == null {
    .labels.last_interacted = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur labels.last_interacted : " + err, level: "warn")
  }
}

# [normalization] CreatedOn -> file.created
if exists(.CreatedOn) {
  _result, err = parse_timestamp(.CreatedOn, format: "%F %T%.f")
  if err == null {
    .file.created = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.created : " + err, level: "warn")
  }
}

# [normalization] ModifiedOn -> file.mtime
if exists(.ModifiedOn) {
  _result, err = parse_timestamp(.ModifiedOn, format: "%F %T%.f")
  if err == null {
    .file.mtime = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.mtime : " + err, level: "warn")
  }
}

# [normalization] AccessedOn -> file.accessed
if exists(.AccessedOn) {
  _result, err = parse_timestamp(.AccessedOn, format: "%F %T%.f")
  if err == null {
    .file.accessed = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.accessed : " + err, level: "warn")
  }
}

# [normalization] MFTEntry -> file.inode
if exists(.MFTEntry) {
  _result, err = to_int(.MFTEntry)
  if err == null {
    .file.inode = _result
  } else {
    log("[shell_bags] échec de l'opération to_int sur file.inode : " + err, level: "warn")
  }
}

# [normalization] HKCU -> registry.hive
.registry.hive = "HKCU"

# [normalization] LastWriteTime -> registry.mtime
if exists(.LastWriteTime) {
  _result, err = parse_timestamp(.LastWriteTime, format: "%F %T%.f")
  if err == null {
    .registry.mtime = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur registry.mtime : " + err, level: "warn")
  }
}

# [normalization] "HKCU\\Local Settings\\Software\\Microsoft\\Windows\\Shell\\" + replace(to_string!(.BagPath), pattern: "\\\\", with: "\\") -> registry.path
if exists(.BagPath) {
  .registry.path = "HKCU\\Local Settings\\Software\\Microsoft\\Windows\\Shell\\" + replace(to_string!(.BagPath), pattern: "\\\\", with: "\\")
}

# [normalization] name -> labels.value
if exists(.name) {
  .labels.value = .name
}

# [normalization] type -> labels.shell_type
if exists(.type) {
  .labels.shell_type = .type
}

# [normalization] localized_name -> labels.localized_name
if exists(.localized_name) {
  .labels.localized_name = .localized_name
}

# [normalization] description -> labels.description
if exists(.description) {
  .labels.description = .description
}

# [normalization] key_security -> labels.key_security
if exists(.key_security) {
  .labels.key_security = .key_security
}

# [normalization] file_reference -> file.inode
if exists(.file_reference) {
  .file.inode = .file_reference
}

# [normalization] replace(to_string!(.path), pattern: "\\\\", with: "\\") -> labels.absolute_path
if exists(.path) {
  .labels.absolute_path = replace(to_string!(.path), pattern: "\\\\", with: "\\")
}

# [normalization] key_modif_time -> timestamp
if exists(.key_modif_time) {
  _result, err = parse_timestamp(.key_modif_time, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .timestamp = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] key_modif_time -> registry.mtime
if exists(.key_modif_time) {
  _result, err = parse_timestamp(.key_modif_time, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .registry.mtime = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur registry.mtime : " + err, level: "warn")
  }
}

# [normalization] modification_time -> file.mtime
if exists(.modification_time) {
  _result, err = parse_timestamp(.modification_time, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .file.mtime = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.mtime : " + err, level: "warn")
  }
}

# [normalization] access_time -> file.accessed
if exists(.access_time) {
  _result, err = parse_timestamp(.access_time, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .file.accessed = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.accessed : " + err, level: "warn")
  }
}

# [normalization] creation_time -> file.created
if exists(.creation_time) {
  _result, err = parse_timestamp(.creation_time, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .file.created = _result
  } else {
    log("[shell_bags] échec de l'opération parse_timestamp sur file.created : " + err, level: "warn")
  }
}

# [normalization] replace(to_string!(.key_path), pattern: "\\\\", with: "\\") -> registry.path
if exists(.key_path) {
  .registry.path = replace(to_string!(.key_path), pattern: "\\\\", with: "\\")
}

# [normalization] True -> labels.has_explored
if !exists(.labels.has_explored) {
  .labels.has_explored = true
}

# [deletion] BagPath, AbsolutePath, ShellType, Value, Miscellaneous, Slot, NodeSlot, MRUPosition, ChildBags, MFTSequenceNumber, ExtensionBlockCount, MFTEntry, CreatedOn, ModifiedOn, AccessedOn, LastWriteTime, FirstInteracted, LastInteracted, HasExplored, name, type, path, file_reference, modification_time, access_time, creation_time, key_path, key_modif_time, key_security, ogre_md, localized_name, description
del(.BagPath)
del(.AbsolutePath)
del(.ShellType)
del(.Value)
del(.Miscellaneous)
del(.Slot)
del(.NodeSlot)
del(.MRUPosition)
del(.ChildBags)
del(.MFTSequenceNumber)
del(.ExtensionBlockCount)
del(.MFTEntry)
del(.CreatedOn)
del(.ModifiedOn)
del(.AccessedOn)
del(.LastWriteTime)
del(.FirstInteracted)
del(.LastInteracted)
del(.HasExplored)
del(.name)
del(.type)
del(.path)
del(.file_reference)
del(.modification_time)
del(.access_time)
del(.creation_time)
del(.key_path)
del(.key_modif_time)
del(.key_security)
del(.ogre_md)
del(.localized_name)
del(.description)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if .labels.has_explored == true && exists(.user.name) && exists(.labels.absolute_path) {
  .message = "User " + to_string!(.user.name) + " interacted with " + to_string!(.labels.absolute_path)
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.user.name), "target": to_string!(.labels.value), "type": "interacted with"})
}
if .labels.has_explored == false && exists(.labels.absolute_path) {
  .message = "Shellbag entry exists for " + to_string!(.labels.absolute_path) + " (no evidence of user interaction)"
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.user.name), "target": to_string!(.labels.value), "type": "referenced"})
}
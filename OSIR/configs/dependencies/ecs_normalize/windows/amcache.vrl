# [normalization] data -> labels.value_data
if exists(.path) && exists(.mtime) && exists(.data) {
  .labels.value_data = .data
}

# [normalization] mtime -> timestamp
if exists(.path) && exists(.mtime) {
  _result, err = parse_timestamp(.mtime, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .timestamp = _result
  } else {
    log("[amcache] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] mtime -> registry.mtime
if exists(.path) && exists(.mtime) {
  _result, err = parse_timestamp(.mtime, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .registry.mtime = _result
  } else {
    log("[amcache] échec de l'opération parse_timestamp sur registry.mtime : " + err, level: "warn")
  }
}

# [normalization] size -> labels.value_size
if exists(.path) && exists(.mtime) && exists(.size) {
  _result, err = to_int(.size)
  if err == null {
    .labels.value_size = _result
  } else {
    log("[amcache] échec de l'opération to_int sur labels.value_size : " + err, level: "warn")
  }
}

# [normalization] is_placeholder -> labels.is_placeholder
if exists(.path) && exists(.mtime) && exists(.is_placeholder) {
  _result, err = to_bool(.is_placeholder)
  if err == null {
    .labels.is_placeholder = _result
  } else {
    log("[amcache] échec de l'opération to_bool sur labels.is_placeholder : " + err, level: "warn")
  }
}


##############################################################
# Module VRL : hayabusa
# Version    : 1.0
# HAYABUSA COMMON MAPPING #
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."log.level") {
  .log.level = get!(., path: ["log.level"])
  del(."log.level")
}
if exists(."event.dataset") {
  .event.dataset = get!(., path: ["event.dataset"])
  del(."event.dataset")
}
if exists(."hayabusa.extra.IpPort") {
  .hayabusa.extra.IpPort = get!(., path: ["hayabusa.extra.IpPort"])
  del(."hayabusa.extra.IpPort")
}
if exists(."hayabusa.details.Path") {
  .hayabusa.details.Path = get!(., path: ["hayabusa.details.Path"])
  del(."hayabusa.details.Path")
}
if exists(."hayabusa.extra.Product Name") {
  .hayabusa.extra."Product Name" = get!(., path: ["hayabusa.extra.Product Name"])
  del(."hayabusa.extra.Product Name")
}
if exists(."hayabusa.extra.Product Version") {
  .hayabusa.extra."Product Version" = get!(., path: ["hayabusa.extra.Product Version"])
  del(."hayabusa.extra.Product Version")
}
if exists(."hayabusa.details.Proc") {
  .hayabusa.details.Proc = get!(., path: ["hayabusa.details.Proc"])
  del(."hayabusa.details.Proc")
}
if exists(."hayabusa.extra.ProcessId") {
  .hayabusa.extra.ProcessId = get!(., path: ["hayabusa.extra.ProcessId"])
  del(."hayabusa.extra.ProcessId")
}
if exists(."source.ip") {
  .source.ip = get!(., path: ["source.ip"])
  del(."source.ip")
}
if exists(."user.name") {
  .user.name = get!(., path: ["user.name"])
  del(."user.name")
}
if exists(."user.target.name") {
  .user.target.name = get!(., path: ["user.target.name"])
  del(."user.target.name")
}
if exists(."process.executable") {
  .process.executable = get!(., path: ["process.executable"])
  del(."process.executable")
}
if exists(."file.path") {
  .file.path = get!(., path: ["file.path"])
  del(."file.path")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
if !exists(.event.original) {
  .event.original = encode_json!(.)
}

# [custom]
if exists(.Timestamp) {
    ts = to_string!(del(.Timestamp))
    parsed_ts = parse_timestamp!(ts, format: "%Y-%m-%d %H:%M:%S%.f %:z")
    .timestamp = format_timestamp!(parsed_ts, format: "%Y-%m-%dT%H:%M:%SZ")
}

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] hayabusa -> event.module
.event.module = "hayabusa"

# [normalization] hayabusa -> agent.type
.agent.type = "hayabusa"

# [normalization] del(.RuleTitle) -> rule.name
if exists(.RuleTitle) {
  .rule.name = del(.RuleTitle)
}

# [normalization] .rule.name -> event.reason
if exists(.rule.name) {
  .event.reason = .rule.name
}

# [normalization] downcase(string!(.Level)) -> log.level
if exists(.Level) {
  .log.level = downcase(string!(.Level))
}

# [normalization] downcase(string!(.Level)) -> hayabusa.level
if exists(.Level) {
  .hayabusa.level = downcase(string!(.Level))
}

# [deletion] Level
del(.Level)

# [normalization] 90 -> event.severity
if .log.level == "crit" || .log.level == "critical" {
  .event.severity = 90
}

# [normalization] 75 -> event.severity
if .log.level == "high" {
  .event.severity = 75
}

# [normalization] 50 -> event.severity
if .log.level == "med" || .log.level == "medium" {
  .event.severity = 50
}

# [normalization] 25 -> event.severity
if .log.level == "low" {
  .event.severity = 25
}

# [normalization] del(.Computer) -> host.name
if exists(.Computer) {
  .host.name = del(.Computer)
}

# [normalization] .Channel -> hayabusa.channel
if exists(.Channel) {
  .hayabusa.channel = .Channel
}

# [normalization] .Channel -> winlog.channel
if exists(.Channel) {
  .winlog.channel = .Channel
}

# [normalization] downcase(string!(.Channel)) -> channel_lower
if exists(.Channel) {
  .channel_lower = downcase(string!(.Channel))
}

# [deletion] Channel
del(.Channel)

# [normalization] windows.security -> event.dataset
if .channel_lower == "sec" {
  .event.dataset = "windows.security"
}

# [normalization] windows.system -> event.dataset
if .channel_lower == "sys" {
  .event.dataset = "windows.system"
}

# [normalization] windows.defender -> event.dataset
if .channel_lower == "defender" {
  .event.dataset = "windows.defender"
}

# [normalization] "hayabusa." + string!(.channel_lower) -> event.dataset
if !exists(.event.dataset) && exists(.channel_lower) {
  .event.dataset = "hayabusa." + string!(.channel_lower)
}

# [deletion] channel_lower
del(.channel_lower)

# [normalization] to_string!(.EventID) -> event.code
if exists(.EventID) {
  .event.code = to_string!(.EventID)
}

# [normalization] to_string!(.EventID) -> winlog.event_id
if exists(.EventID) {
  .winlog.event_id = to_string!(.EventID)
}

# [deletion] EventID
del(.EventID)

# [normalization] to_string!(del(.RecordID)) -> winlog.record_id
if exists(.RecordID) {
  .winlog.record_id = to_string!(del(.RecordID))
}

# [normalization] del(.Details) -> hayabusa.details
if exists(.Details) {
  .hayabusa.details = del(.Details)
}

# [normalization] del(.ExtraFieldInfo) -> hayabusa.extra
if exists(.ExtraFieldInfo) {
  .hayabusa.extra = del(.ExtraFieldInfo)
}

# [normalization] .hayabusa.extra.SubjectUserName -> user.name
if exists(.hayabusa.extra.SubjectUserName) {
  .user.name = .hayabusa.extra.SubjectUserName
}

# [normalization] .hayabusa.extra.SubjectDomainName -> user.domain
if exists(.hayabusa.extra.SubjectDomainName) {
  .user.domain = .hayabusa.extra.SubjectDomainName
}

# [normalization] .hayabusa.extra.SubjectUserSid -> user.id
if exists(.hayabusa.extra.SubjectUserSid) {
  .user.id = .hayabusa.extra.SubjectUserSid
}

# [normalization] .hayabusa.extra.SubjectLogonId -> winlog.subject.logon_id
if exists(.hayabusa.extra.SubjectLogonId) {
  .winlog.subject.logon_id = .hayabusa.extra.SubjectLogonId
}

# [normalization] .hayabusa.extra.TargetDomainName -> user.target.domain
if exists(.hayabusa.extra.TargetDomainName) {
  .user.target.domain = .hayabusa.extra.TargetDomainName
}

# [normalization] .hayabusa.details.SrcComp -> source.domain
if exists(.hayabusa.details.SrcComp) {
  .source.domain = .hayabusa.details.SrcComp
}

# [normalization] .hayabusa.details.SrcIP -> source.ip
if exists(.hayabusa.details.SrcIP) {
  .source.ip = .hayabusa.details.SrcIP
}

# [normalization] to_string!(.hayabusa.extra.IpPort) -> source.port
if exists(.hayabusa.extra.IpPort) {
  .source.port = to_string!(.hayabusa.extra.IpPort)
}

# [normalization] .hayabusa.details.AuthPkg -> winlog.logon.authentication_package
if exists(.hayabusa.details.AuthPkg) {
  .winlog.logon.authentication_package = .hayabusa.details.AuthPkg
}

# [normalization] .hayabusa.details.Type -> winlog.logon.type
if exists(.hayabusa.details.Type) {
  .winlog.logon.type = .hayabusa.details.Type
}

# [normalization] .hayabusa.extra.LogonProcessName -> winlog.logon.process.name
if exists(.hayabusa.extra.LogonProcessName) {
  .winlog.logon.process.name = .hayabusa.extra.LogonProcessName
}

# [normalization] .hayabusa.extra.KeyLength -> winlog.logon.key_length
if exists(.hayabusa.extra.KeyLength) {
  .winlog.logon.key_length = .hayabusa.extra.KeyLength
}

# [normalization] .hayabusa.details.Path -> process.executable
if exists(.hayabusa.details.Path) {
  .process.executable = .hayabusa.details.Path
}

# [normalization] .hayabusa.details.Path -> file.path
if exists(.hayabusa.details.Path) {
  .file.path = .hayabusa.details.Path
}

# [normalization] basename!(.hayabusa.details.Path) -> file.name
if exists(.hayabusa.details.Path) {
  .file.name = basename!(.hayabusa.details.Path)
}

# [normalization] .hayabusa.details.Svc -> service.display_name
if exists(.hayabusa.details.Svc) {
  .service.display_name = .hayabusa.details.Svc
}

# [normalization] .hayabusa.details.Acct -> service.account
if exists(.hayabusa.details.Acct) {
  .service.account = .hayabusa.details.Acct
}

# [normalization] .hayabusa.details.StartType -> service.start_type
if exists(.hayabusa.details.StartType) {
  .service.start_type = .hayabusa.details.StartType
}

# [normalization] .hayabusa.extra.ServiceType -> service.type
if exists(.hayabusa.extra.ServiceType) {
  .service.type = .hayabusa.extra.ServiceType
}

# [normalization] .hayabusa.extra."Product Name" -> observer.product
if exists(.hayabusa.extra."Product Name") {
  .observer.product = .hayabusa.extra."Product Name"
}

# [normalization] .hayabusa.extra."Product Version" -> observer.version
if exists(.hayabusa.extra."Product Version") {
  .observer.version = .hayabusa.extra."Product Version"
}

# [normalization] .hayabusa.extra.FailureReason -> error.message
if exists(.hayabusa.extra.FailureReason) {
  .error.message = .hayabusa.extra.FailureReason
}

# [normalization] .hayabusa.extra.Status -> winlog.status
if exists(.hayabusa.extra.Status) {
  .winlog.status = .hayabusa.extra.Status
}

# [normalization] .hayabusa.extra.SubStatus -> winlog.sub_status
if exists(.hayabusa.extra.SubStatus) {
  .winlog.sub_status = .hayabusa.extra.SubStatus
}

# [normalization] .hayabusa.details.TgtUser -> user.target.name
if exists(.hayabusa.details.TgtUser) {
  .user.target.name = .hayabusa.details.TgtUser
}

# [normalization] .hayabusa.extra.TargetUserName -> user.target.name
if exists(.hayabusa.extra.TargetUserName) {
  .user.target.name = .hayabusa.extra.TargetUserName
}

# [normalization] .hayabusa.extra.TargetUserSid -> user.target.id
if exists(.hayabusa.extra.TargetUserSid) {
  .user.target.id = .hayabusa.extra.TargetUserSid
}

# [normalization] .hayabusa.extra.TargetSid -> user.target.id
if exists(.hayabusa.extra.TargetSid) {
  .user.target.id = .hayabusa.extra.TargetSid
}

# [normalization] .hayabusa.details.Proc -> process.executable
if exists(.hayabusa.details.Proc) && .hayabusa.details.Proc != "-" {
  .process.executable = .hayabusa.details.Proc
}

# [normalization] to_int(.hayabusa.extra.ProcessId) ?? null -> process.pid
if (to_int(.hayabusa.extra.ProcessId) ?? 0) != 0 && exists(.hayabusa.extra.ProcessId) {
  .process.pid = to_int(.hayabusa.extra.ProcessId) ?? null
}

# [normalization] ['authentication'] -> event.category
if .event.code == "4625" {
  .event.category = ["authentication"]
}

# [normalization] ['start', 'denied'] -> event.type
if .event.code == "4625" {
  .event.type = ["start", "denied"]
}

# [normalization] logon_failed -> event.action
if .event.code == "4625" {
  .event.action = "logon_failed"
}

# [normalization] failure -> event.outcome
if .event.code == "4625" {
  .event.outcome = "failure"
}

# [normalization] [.source.ip] -> related.ip
if .event.code == "4625" && exists(.source.ip) {
  .related.ip = [.source.ip]
}

# [normalization] .user.target.name -> user.name
if .event.code == "4625" && !exists(.user.name) && exists(.user.target.name) {
  .user.name = .user.target.name
}

# [normalization] [.user.name] -> related.user
if .event.code == "4625" && exists(.user.name) {
  .related.user = [.user.name]
}

# [normalization] ['iam'] -> event.category
if .event.code == "4724" {
  .event.category = ["iam"]
}

# [normalization] ['change'] -> event.type
if .event.code == "4724" {
  .event.type = ["change"]
}

# [normalization] password_reset_attempt -> event.action
if .event.code == "4724" {
  .event.action = "password_reset_attempt"
}

# [normalization] [.user.target.name] -> related.user
if .event.code == "4724" && exists(.user.target.name) {
  .related.user = [.user.target.name]
}

# [normalization] ['process', 'persistence'] -> event.category
if .event.code == "7045" {
  .event.category = ["process", "persistence"]
}

# [normalization] ['creation', 'start'] -> event.type
if .event.code == "7045" {
  .event.type = ["creation", "start"]
}

# [normalization] service_installed -> event.action
if .event.code == "7045" {
  .event.action = "service_installed"
}

# [normalization] basename!(.process.executable) -> file.name
if .event.code == "7045" && !exists(.file.name) && exists(.process.executable) {
  .file.name = basename!(.process.executable)
}

# [normalization] [.file.path] -> related.files
if .event.code == "7045" && exists(.file.path) {
  .related.files = [.file.path]
}

# [normalization] ['malware', 'configuration'] -> event.category
if .event.code == "5010" {
  .event.category = ["malware", "configuration"]
}

# [normalization] ['change'] -> event.type
if .event.code == "5010" {
  .event.type = ["change"]
}

# [normalization] defender_scanning_disabled -> event.action
if .event.code == "5010" {
  .event.action = "defender_scanning_disabled"
}

# [normalization] ['authentication'] -> event.category
if .event.code == "6038" {
  .event.category = ["authentication"]
}

# [normalization] ['protocol'] -> event.type
if .event.code == "6038" {
  .event.type = ["protocol"]
}

# [normalization] ntlmv1_authentication_detected -> event.action
if .event.code == "6038" {
  .event.action = "ntlmv1_authentication_detected"
}

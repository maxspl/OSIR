##############################################################
# Module VRL : tcpvcon
# Version    : 1.0
# Sysinternals Tcpvcon
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [custom]
if !exists(.event) || !exists(.event.original) {
    .event.original = encode_json!(.)
}

# [normalization] windows.tcpvcon -> event.dataset
.event.dataset = "windows.tcpvcon"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] state -> event.kind
.event.kind = "state"

# [normalization] ['network'] -> event.category
.event.category = ["network"]

# [normalization] ['info', 'connection'] -> event.type
.event.type = ["info", "connection"]

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] Sysinternals Tcpvcon -> event.provider
.event.provider = "Sysinternals Tcpvcon"

# [normalization] ip -> network.protocol
.network.protocol = "ip"

# [custom]
rec_type = null

if exists(.type) {
    rec_type = to_string!(del(.type))
    .event.code   = rec_type
    .event.action = downcase(rec_type)
}

if exists(.protocol) {
    proto_raw = to_string!(del(.protocol))
    proto_l   = downcase(proto_raw)

    .network.transport = proto_l
    .network.protocol  = proto_l
}

# [normalization] to_string!(del(.process_name)) -> process.name
if exists(.process_name) {
  .process.name = to_string!(del(.process_name))
}

# [custom]
if exists(.pid) {
    pid_raw = to_string!(del(.pid))
    pid_int = parse_int(pid_raw) ?? null

    if pid_int != null {
        .process.pid = pid_int
    } else {
        .process.pid = pid_raw
    }
}

if exists(.state) {
    state_raw = to_string!(del(.state))
    state_l   = downcase(state_raw)

    .network.Ext.tcp_state = state_raw

    .event.action = state_l

    if state_l == "listening" {
        .network.direction = "ingress"
    }
}

local_ip  = null

remote_ip = null

if exists(.local_address) {
    local_ip = to_string!(del(.local_address))
    if local_ip != "" {
        .source.ip = local_ip
    }
}

if exists(.remote_address) {
    remote_ip = to_string!(del(.remote_address))
    if remote_ip != "" {
        .destination.ip = remote_ip
    }
}

ip_sample = null

if local_ip != null && local_ip != "" {
    ip_sample = local_ip
} else if remote_ip != null && remote_ip != "" {
    ip_sample = remote_ip
}

if ip_sample != null {
    ip_str = to_string!(ip_sample)
    if contains(ip_str, ":") {
        .network.type = "ipv6"
    } else {
        .network.type = "ipv4"
    }
}

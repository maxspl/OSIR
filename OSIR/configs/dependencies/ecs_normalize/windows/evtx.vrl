# [custom]
if !exists(.source.ip) {
  ip_candidates = [
    .Event.EventData.IpAddress,
    .Event.EventData.SourceIp,
    .Event.EventData.SourceAddress,
    .Event.EventData.SourceAddr,
    .Event.EventData.SourceNetworkAddress,
    .Event.EventData.NetworkAddress,
    .Event.EventData.ClientAddress,
    .Event.EventData.ClientIP,
    .action.properties.Address
  ]
  if .action.type == "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational" && .event.id == 1149 {
    ip_candidates = push(ip_candidates, .action.properties.Param3)
  }
  ips = []
  for_each(ip_candidates) -> |_i, v| {
    ip = replace(to_string(v) ?? "", r'^::ffff:', "")
    # "1.2.3.4:3389" / "[::1]:3389"
    ip_port = parse_regex(ip, r'^\[?(?P<ip>[0-9a-fA-F:.]+?)\]?:(?P<port>\d+)$') ?? {}
    if !is_ipv6(ip) && exists(ip_port.ip) {
      ip = string!(ip_port.ip)
      if !exists(.source.port) { .source.port = ip_port.port }
    }
    if is_ipv4(ip) || is_ipv6(ip) {
      ips = push(ips, ip)
    }
  }
  if length(ips) > 0 {
    .source.ip = ips[0]
    .source.address = ips[0]
  }
}


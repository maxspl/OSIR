##############################################################
# Module VRL : amcache
# Version    : 1.0
# Amcache artifacts (AmcacheParser CSV + dfir-ogre Amcache.hve JSONL) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."file.path") {
  .file.path = get!(., path: ["file.path"])
  del(."file.path")
}
if exists(."file.hash.sha1") {
  .file.hash.sha1 = get!(., path: ["file.hash.sha1"])
  del(."file.hash.sha1")
}
if exists(."labels.friendly_name") {
  .labels.friendly_name = get!(., path: ["labels.friendly_name"])
  del(."labels.friendly_name")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
.event.original = encode_json!(.)

# [normalization] windows.amcache -> event.dataset
.event.dataset = "windows.amcache"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['file', 'driver', 'device'] -> event.category
.event.category = ["file", "driver", "device"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [normalization] Windows AmCache -> event.provider
.event.provider = "Windows AmCache"

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] FileKeyLastWriteTimestamp -> timestamp
if exists(.FullPath) && exists(.FileKeyLastWriteTimestamp) {
  _result, err = parse_timestamp(.FileKeyLastWriteTimestamp, format: "%F %T")
  if err == null {
    .timestamp = _result
  } else {
    log("[amcache] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] FileKeyLastWriteTimestamp -> registry.mtime
if exists(.FullPath) && exists(.FileKeyLastWriteTimestamp) {
  _result, err = parse_timestamp(.FileKeyLastWriteTimestamp, format: "%F %T")
  if err == null {
    .registry.mtime = _result
  } else {
    log("[amcache] échec de l'opération parse_timestamp sur registry.mtime : " + err, level: "warn")
  }
}

# [normalization] Amcache -> registry.hive
if exists(.FullPath) {
  .registry.hive = "Amcache"
}

# [normalization] FullPath -> file.path
if exists(.FullPath) {
  .file.path = .FullPath
}

# [normalization] Name -> file.name

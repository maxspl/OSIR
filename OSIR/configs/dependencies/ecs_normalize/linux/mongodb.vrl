##############################################################
# Module VRL : mongodb
# Version    : 1.0
# OSIR - MongoDB log normalizer
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."event.severity") {
  .event.severity = get!(., path: ["event.severity"])
  del(."event.severity")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] get(.t, ["$date"]) ?? null -> timestamp
if exists(.t) {
  .timestamp = get(.t, ["$date"]) ?? null
}

# [deletion] t
del(.t)

# [normalization] fatal -> event.severity
if .s == "F" {
  .event.severity = "fatal"
}

# [normalization] error -> event.severity
if .s == "E" {
  .event.severity = "error"
}

# [normalization] warning -> event.severity
if .s == "W" {
  .event.severity = "warning"
}

# [normalization] informational -> event.severity
if .s == "I" {
  .event.severity = "informational"
}

# [normalization] "debug " + string!(.s) -> event.severity
if !exists(.event.severity) && starts_with(string!(.s), "D") && exists(.s) {
  .event.severity = "debug " + string!(.s)
}

# [normalization] string!(.s) -> event.severity
if !exists(.event.severity) && exists(.s) {
  .event.severity = string!(.s)
}

# [deletion] s
del(.s)

# [normalization] to_string!(del(.c)) -> event.kind
if exists(.c) {
  .event.kind = to_string!(del(.c))
}

# [normalization] del(.id) -> event.id
if exists(.id) {
  .event.id = del(.id)
}

# [normalization] to_string!(del(.ctx)) -> event.context
if exists(.ctx) {
  .event.context = to_string!(del(.ctx))
}

# [normalization] to_string!(del(.svc)) -> service.name
if exists(.svc) {
  .service.name = to_string!(del(.svc))
}

# [normalization] to_string!(del(.msg)) -> message
if exists(.msg) {
  .message = to_string!(del(.msg))
}

# [normalization] del(.attr) -> log
if exists(.attr) {
  .log = del(.attr)
}

# [custom]
if exists(.log.remote) {
    remote_val = to_string!(.log.remote)
    parts = split(remote_val, ":")
    if length(parts) == 2 {
        .source.address = remote_val
        .source.ip = parts[0]
        .source.port = to_int!(parts[1])
    }
    del(.log.remote)
}

if exists(.log.uuid.uuid) {
    uuid_val, err = get(.log.uuid.uuid, ["$uuid"])
    if uuid_val != null {
        .log.uuid = to_string!(uuid_val)
    }
    del(.log.uuid.uuid)
}

# [normalization] del(.tags) -> log.tags
if exists(.tags) {
  .log.tags = del(.tags)
}

# [normalization] del(.truncated) -> log.truncated
if exists(.truncated) {
  .log.truncated = del(.truncated)
}

# [normalization] del(.size) -> log.size
if exists(.size) {
  .log.size = del(.size)
}

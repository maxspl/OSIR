# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.labels.app_id) && exists(.user.id) {
  .message = "Application " + to_string!(.labels.app_id) + " was used by user " + to_string!(.user.id)
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.user.id), "target": to_string!(.labels.app_id), "type": "used"})
}
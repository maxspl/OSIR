# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] .Event.System.TimeCreated."#attributes".SystemTime -> timestamp
if exists(.Event.System.TimeCreated."#attributes".SystemTime) {
  .timestamp = .Event.System.TimeCreated."#attributes".SystemTime
}

# [normalization] Event.System -> action.system
if exists(.Event.System) {
  .action.system = .Event.System
}

# [normalization] Event.EventData -> action.properties
if exists(.Event.EventData) {
  .action.properties = .Event.EventData
}

# [normalization] Event.EventData.Attributes -> action.properties.Attributes
if exists(.Event.EventData.Attributes) {
  .action.properties.Attributes = .Event.EventData.Attributes
}

# [normalization] Event.EventData.Requester -> action.properties.Requester

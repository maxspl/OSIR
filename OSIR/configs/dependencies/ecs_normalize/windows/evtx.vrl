# [deletion] threat.technique.id_name
if is_empty(to_string!(.threat.technique.id_name)) {
  del(."threat.technique.id_name")
}

# [normalization] to_string!(.Event.System.Channel) -> event.dataset
if exists(.Event.System.Channel) {
  .event.dataset = to_string!(.Event.System.Channel)
}

# [custom]
if is_string(.Event.EventData.Hashes) {
  .parsed_hashes_kv = parse_key_value(.Event.EventData.Hashes, key_value_delimiter:"=", field_delimiter:",") ?? {}
}

# [custom]
if is_string(.Event.EventData.Hash) {
  .parsed_hashes_kv_2 = parse_key_value(.Event.EventData.Hash, key_value_delimiter:"=", field_delimiter:",") ?? {}
}

# [normalization] Event.EventData.ImageLoaded -> dll.path
if .Event.System.Provider."#attributes".Name == "Microsoft-Windows-Sysmon" && .event.id == 7 && exists(.Event.EventData.ImageLoaded) {
  .dll.path = .Event.EventData.ImageLoaded
}

# [normalization] Event.EventData.OriginalFileName -> dll.name
if .Event.System.Provider."#attributes".Name == "Microsoft-Windows-Sysmon" && .event.id == 7 && exists(.Event.EventData.OriginalFileName) {
  .dll.name = .Event.EventData.OriginalFileName

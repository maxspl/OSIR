##############################################################
# Module VRL : dpkg
# Version    : 1.0
# OSIR - dpkg package status normalizer
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################


# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] to_string!(.name) -> package.name
if exists(.name) {
  .package.name = to_string!(.name)
}

# [normalization] to_string!(.version) -> package.version
if exists(.version) {
  .package.version = to_string!(.version)
}

# [normalization] to_string!(.architecture) -> package.architecture
if exists(.architecture) {
  .package.architecture = to_string!(.architecture)
}

# [normalization] to_string!(.description) -> package.description
if exists(.description) {
  .package.description = to_string!(.description)
}

# [normalization] to_string!(.desired) -> package.install_scope
if exists(.desired) {
  .package.install_scope = to_string!(.desired)
}

# [normalization] dpkg -> package.type
.package.type = "dpkg"

# [normalization] to_string!(.status) -> labels.package_status
if exists(.status) {
  .labels.package_status = to_string!(.status)
}

# [normalization] to_string!(.codes) -> labels.package_codes
if exists(.codes) {
  .labels.package_codes = to_string!(.codes)
}

# [custom]
if exists(.codes) {
    codes = to_string!(.codes)

    if length(codes) >= 1 {
        desired_code = slice!(codes, 0, 1)
        .labels.package_desired_state = if desired_code == "u" {
            "unknown"
        } else if desired_code == "i" {
            "install"
        } else if desired_code == "r" {
            "remove"
        } else if desired_code == "p" {
            "purge"
        } else if desired_code == "h" {
            "hold"
        } else {
            desired_code
        }
    }

    if length(codes) >= 2 {
        current_code = slice!(codes, 1, 2)
        .labels.package_current_state = if current_code == "n" {
            "not-installed"
        } else if current_code == "i" {
            "installed"
        } else if current_code == "c" {
            "config-files"
        } else if current_code == "U" {
            "unpacked"
        } else if current_code == "F" {
            "half-configured"
        } else if current_code == "h" {
            "half-installed"
        } else if current_code == "W" {
            "triggers-awaited"
        } else if current_code == "t" {
            "triggers-pending"
        } else {
            current_code
        }
    }

    if length(codes) >= 3 {
        error_code = slice!(codes, 2, 3)
        if error_code != " " {
            .labels.package_error_state = if error_code == "R" {
                "reinst-required"
            } else {
                error_code
            }
        }
    }
}

# [deletion] codes, name, version, architecture, description, desired, status
del(.codes)
del(.name)
del(.version)
del(.architecture)
del(.description)
del(.desired)
del(.status)

    .action.properties.Username,
    .action.properties.PrincipalSamName
  ])
  user_candidates = filter(user_candidates) -> |_i, v| { is_string(v) && v != "-" && v != "NULL" }
  if length(user_candidates) > 0 {
    .user.name = user_candidates[0]
  }
}


##############################################################
# Module VRL : hives
# Version    : 1.0
# Registry artifacts (RECmd CSV + dfir-ogre hive JSONL) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."registry.value") {
  .registry.value = get!(., path: ["registry.value"])
  del(."registry.value")
}
if exists(."registry.path") {
  .registry.path = get!(., path: ["registry.path"])
  del(."registry.path")
}
if exists(."user.name") {
  .user.name = get!(., path: ["user.name"])
  del(."user.name")
}
if exists(."user.id") {
  .user.id = get!(., path: ["user.id"])
  del(."user.id")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
.event.original = encode_json!(.)

# [normalization] windows.registry -> event.dataset
.event.dataset = "windows.registry"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['registry'] -> event.category
.event.category = ["registry"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [normalization] Windows Registry -> event.provider
.event.provider = "Windows Registry"

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] KeyPath -> registry.path
if exists(.HiveType) && exists(.KeyPath) {
  .registry.path = .KeyPath
}

# [normalization] ValueName -> registry.value
if exists(.HiveType) && exists(.KeyPath) && exists(.ValueName) {
  .registry.value = .ValueName
}

# [normalization] ValueType -> registry.data.type
if exists(.HiveType) && exists(.KeyPath) && exists(.ValueType) {
  .registry.data.type = .ValueType
}

# [normalization] HiveType -> registry.hive
if exists(.HiveType) && exists(.KeyPath) {
  .registry.hive = .HiveType
}

# [normalization] HivePath -> labels.hive_path
if exists(.HiveType) && exists(.KeyPath) && exists(.HivePath) {
  .labels.hive_path = .HivePath
}

# [normalization] Description -> labels.description
if exists(.HiveType) && exists(.KeyPath) && exists(.Description) {
  .labels.description = .Description
}

# [normalization] Category -> labels.category
if exists(.HiveType) && exists(.KeyPath) && exists(.Category) {
  .labels.category = .Category
}

# [normalization] Comment -> labels.comment
if exists(.HiveType) && exists(.KeyPath) && exists(.Comment) {
  .labels.comment = .Comment
}

# [normalization] ValueData -> labels.value_data
if exists(.HiveType) && exists(.KeyPath) && exists(.ValueData) {
  .labels.value_data = .ValueData
}

# [normalization] ValueData2 -> labels.value_data2
if exists(.HiveType) && exists(.KeyPath) && exists(.ValueData2) {
  .labels.value_data2 = .ValueData2
}

# [normalization] ValueData3 -> labels.value_data3
if exists(.HiveType) && exists(.KeyPath) && exists(.ValueData3) {
  .labels.value_data3 = .ValueData3
}

# [normalization] Recursive -> labels.recursive
if exists(.HiveType) && exists(.KeyPath) && exists(.Recursive) {
  _result, err = to_bool(.Recursive)
  if err == null {
    .labels.recursive = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.recursive : " + err, level: "warn")
  }
}

# [normalization] Deleted -> labels.deleted
if exists(.HiveType) && exists(.KeyPath) && exists(.Deleted) {
  _result, err = to_bool(.Deleted)
  if err == null {
    .labels.deleted = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.deleted : " + err, level: "warn")
  }
}

# [normalization] PluginDetailFile -> labels.plugin_detail_file
if exists(.HiveType) && exists(.KeyPath) && exists(.PluginDetailFile) {
  .labels.plugin_detail_file = .PluginDetailFile
}

# [normalization] LastWriteTimestamp -> timestamp
if exists(.HiveType) && exists(.KeyPath) && exists(.LastWriteTimestamp) {
  _result, err = parse_timestamp(.LastWriteTimestamp, format: "%F %T%.f")
  if err == null {
    .timestamp = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] BatchKeyPath -> registry.path
if exists(.BatchKeyPath) && exists(.UserId) {
  .registry.path = .BatchKeyPath
}

# [normalization] BatchValueName -> registry.value
if exists(.BatchKeyPath) && exists(.UserId) && exists(.BatchValueName) {
  .registry.value = .BatchValueName
}

# [normalization] SAM -> registry.hive
if exists(.BatchKeyPath) && exists(.UserId) {
  .registry.hive = "SAM"
}

# [normalization] UserId -> user.id
if exists(.BatchKeyPath) && exists(.UserId) {
  .user.id = .UserId
}

# [normalization] UserName -> user.name
if exists(.BatchKeyPath) && exists(.UserId) && exists(.UserName) {
  .user.name = .UserName
}

# [normalization] FullName -> user.full_name
if exists(.BatchKeyPath) && exists(.UserId) && exists(.FullName) {
  .user.full_name = .FullName
}

# [normalization] InternetUserName -> user.email
if exists(.BatchKeyPath) && exists(.UserId) && exists(.InternetUserName) {
  .user.email = .InternetUserName
}

# [normalization] PasswordHint -> labels.password_hint
if exists(.BatchKeyPath) && exists(.UserId) && exists(.PasswordHint) {
  .labels.password_hint = .PasswordHint
}

# [normalization] Groups -> labels.groups
if exists(.BatchKeyPath) && exists(.UserId) && exists(.Groups) {
  .labels.groups = .Groups
}

# [normalization] Comment -> labels.comment
if exists(.BatchKeyPath) && exists(.UserId) && exists(.Comment) {
  .labels.comment = .Comment
}

# [normalization] UserComment -> labels.user_comment
if exists(.BatchKeyPath) && exists(.UserId) && exists(.UserComment) {
  .labels.user_comment = .UserComment
}

# [normalization] HomeDirectory -> labels.home_directory
if exists(.BatchKeyPath) && exists(.UserId) && exists(.HomeDirectory) {
  .labels.home_directory = .HomeDirectory
}

# [normalization] ValidUserId -> labels.valid_user_id
if exists(.BatchKeyPath) && exists(.UserId) && exists(.ValidUserId) {
  _result, err = to_bool(.ValidUserId)
  if err == null {
    .labels.valid_user_id = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.valid_user_id : " + err, level: "warn")
  }
}

# [normalization] InvalidLoginCount -> labels.invalid_login_count
if exists(.BatchKeyPath) && exists(.UserId) && exists(.InvalidLoginCount) {
  _result, err = to_int(.InvalidLoginCount)
  if err == null {
    .labels.invalid_login_count = _result
  } else {
    log("[hives] échec de l'opération to_int sur labels.invalid_login_count : " + err, level: "warn")
  }
}

# [normalization] TotalLoginCount -> labels.total_login_count
if exists(.BatchKeyPath) && exists(.UserId) && exists(.TotalLoginCount) {
  _result, err = to_int(.TotalLoginCount)
  if err == null {
    .labels.total_login_count = _result
  } else {
    log("[hives] échec de l'opération to_int sur labels.total_login_count : " + err, level: "warn")
  }
}

# [normalization] ResetData -> labels.reset_data
if exists(.BatchKeyPath) && exists(.UserId) && exists(.ResetData) {
  _result, err = to_bool(.ResetData)
  if err == null {
    .labels.reset_data = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.reset_data : " + err, level: "warn")
  }
}

# [normalization] AccountDisabled -> labels.account_disabled
if exists(.BatchKeyPath) && exists(.UserId) && exists(.AccountDisabled) {
  _result, err = to_bool(.AccountDisabled)
  if err == null {
    .labels.account_disabled = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.account_disabled : " + err, level: "warn")
  }
}

# [normalization] HomeDirectoryRequired -> labels.home_directory_required
if exists(.BatchKeyPath) && exists(.UserId) && exists(.HomeDirectoryRequired) {
  _result, err = to_bool(.HomeDirectoryRequired)
  if err == null {
    .labels.home_directory_required = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.home_directory_required : " + err, level: "warn")
  }
}

# [normalization] PasswordNotRequired -> labels.password_not_required
if exists(.BatchKeyPath) && exists(.UserId) && exists(.PasswordNotRequired) {
  _result, err = to_bool(.PasswordNotRequired)
  if err == null {
    .labels.password_not_required = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.password_not_required : " + err, level: "warn")
  }
}

# [normalization] TempDuplicateAccount -> labels.temp_duplicate_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.TempDuplicateAccount) {
  _result, err = to_bool(.TempDuplicateAccount)
  if err == null {
    .labels.temp_duplicate_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.temp_duplicate_account : " + err, level: "warn")
  }
}

# [normalization] NormalUserAccount -> labels.normal_user_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.NormalUserAccount) {
  _result, err = to_bool(.NormalUserAccount)
  if err == null {
    .labels.normal_user_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.normal_user_account : " + err, level: "warn")
  }
}

# [normalization] MnsLogonAccount -> labels.mns_logon_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.MnsLogonAccount) {
  _result, err = to_bool(.MnsLogonAccount)
  if err == null {
    .labels.mns_logon_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.mns_logon_account : " + err, level: "warn")
  }
}

# [normalization] InterdomainTrustAccount -> labels.interdomain_trust_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.InterdomainTrustAccount) {
  _result, err = to_bool(.InterdomainTrustAccount)
  if err == null {
    .labels.interdomain_trust_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.interdomain_trust_account : " + err, level: "warn")
  }
}

# [normalization] WorkstationTrustAccount -> labels.workstation_trust_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.WorkstationTrustAccount) {
  _result, err = to_bool(.WorkstationTrustAccount)
  if err == null {
    .labels.workstation_trust_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.workstation_trust_account : " + err, level: "warn")
  }
}

# [normalization] ServerTrustAccount -> labels.server_trust_account
if exists(.BatchKeyPath) && exists(.UserId) && exists(.ServerTrustAccount) {
  _result, err = to_bool(.ServerTrustAccount)
  if err == null {
    .labels.server_trust_account = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.server_trust_account : " + err, level: "warn")
  }
}

# [normalization] PasswordDoesNotExpire -> labels.password_does_not_expire
if exists(.BatchKeyPath) && exists(.UserId) && exists(.PasswordDoesNotExpire) {
  _result, err = to_bool(.PasswordDoesNotExpire)
  if err == null {
    .labels.password_does_not_expire = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.password_does_not_expire : " + err, level: "warn")
  }
}

# [normalization] AutoLocked -> labels.auto_locked
if exists(.BatchKeyPath) && exists(.UserId) && exists(.AutoLocked) {
  _result, err = to_bool(.AutoLocked)
  if err == null {
    .labels.auto_locked = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.auto_locked : " + err, level: "warn")
  }
}

# [normalization] CreatedOn -> timestamp
if exists(.CreatedOn) && .CreatedOn != "" {
  _result, err = parse_timestamp(.CreatedOn, format: "%F %T%.f")
  if err == null {
    .timestamp = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] LastLoginTime -> labels.last_login_time
if exists(.LastLoginTime) && .LastLoginTime != "" {
  _result, err = parse_timestamp(.LastLoginTime, format: "%F %T%.f")
  if err == null {
    .labels.last_login_time = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur labels.last_login_time : " + err, level: "warn")
  }
}

# [normalization] LastPasswordChange -> labels.last_password_change
if exists(.LastPasswordChange) && .LastPasswordChange != "" {
  _result, err = parse_timestamp(.LastPasswordChange, format: "%F %T%.f")
  if err == null {
    .labels.last_password_change = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur labels.last_password_change : " + err, level: "warn")
  }
}

# [normalization] LastIncorrectPassword -> labels.last_incorrect_password
if exists(.LastIncorrectPassword) && .LastIncorrectPassword != "" {
  _result, err = parse_timestamp(.LastIncorrectPassword, format: "%F %T%.f")
  if err == null {
    .labels.last_incorrect_password = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur labels.last_incorrect_password : " + err, level: "warn")
  }
}

# [normalization] ExpiresOn -> labels.expires_on
if exists(.ExpiresOn) && .ExpiresOn != "" {
  _result, err = parse_timestamp(.ExpiresOn, format: "%F %T%.f")
  if err == null {
    .labels.expires_on = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur labels.expires_on : " + err, level: "warn")
  }
}

# [normalization] replace(to_string!(.path), pattern: "\\\\", with: "\\") -> registry.path
if exists(.path) && exists(.mtime) {
  .registry.path = replace(to_string!(.path), pattern: "\\\\", with: "\\")
}

# [normalization] name -> registry.value
if exists(.path) && exists(.mtime) && exists(.name) {
  .registry.value = .name
}

# [normalization] type -> registry.data.type
if exists(.path) && exists(.mtime) && exists(.type) {
  .registry.data.type = .type
}

# [normalization] data -> labels.value_data
if exists(.path) && exists(.mtime) && exists(.data) {
  .labels.value_data = .data
}

# [normalization] mtime -> registry.mtime
if exists(.path) && exists(.mtime) {
  _result, err = parse_timestamp(.mtime, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .registry.mtime = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur registry.mtime : " + err, level: "warn")
  }
}

# [normalization] mtime -> timestamp
if exists(.path) && exists(.mtime) {
  _result, err = parse_timestamp(.mtime, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .timestamp = _result
  } else {
    log("[hives] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] size -> labels.value_size
if exists(.path) && exists(.mtime) && exists(.size) {
  _result, err = to_int(.size)
  if err == null {
    .labels.value_size = _result
  } else {
    log("[hives] échec de l'opération to_int sur labels.value_size : " + err, level: "warn")
  }
}

# [normalization] is_placeholder -> labels.is_placeholder
if exists(.path) && exists(.mtime) && exists(.is_placeholder) {
  _result, err = to_bool(.is_placeholder)
  if err == null {
    .labels.is_placeholder = _result
  } else {
    log("[hives] échec de l'opération to_bool sur labels.is_placeholder : " + err, level: "warn")
  }
}

# [normalization] security_descriptor -> labels.security_descriptor
if exists(.path) && exists(.mtime) && exists(.security_descriptor) {
  .labels.security_descriptor = .security_descriptor
}

# [deletion] HivePath, HiveType, Description, Category, KeyPath, ValueName, ValueType, ValueData, ValueData2, ValueData3, Comment, Recursive, Deleted, LastWriteTimestamp, PluginDetailFile, ValidUserId, BatchKeyPath, BatchValueName, UserId, InvalidLoginCount, TotalLoginCount, CreatedOn, LastLoginTime, LastPasswordChange, LastIncorrectPassword, ExpiresOn, UserName, FullName, PasswordHint, Groups, UserComment, HomeDirectory, InternetUserName, ResetData, AccountDisabled, HomeDirectoryRequired, PasswordNotRequired, TempDuplicateAccount, NormalUserAccount, MnsLogonAccount, InterdomainTrustAccount, WorkstationTrustAccount, ServerTrustAccount, PasswordDoesNotExpire, AutoLocked, path, mtime, name, data, type, size, is_placeholder, security_descriptor, ogre_md
del(.HivePath)
del(.HiveType)
del(.Description)
del(.Category)
del(.KeyPath)
del(.ValueName)
del(.ValueType)
del(.ValueData)
del(.ValueData2)
del(.ValueData3)
del(.Comment)
del(.Recursive)
del(.Deleted)
del(.LastWriteTimestamp)
del(.PluginDetailFile)
del(.ValidUserId)
del(.BatchKeyPath)
del(.BatchValueName)
del(.UserId)
del(.InvalidLoginCount)
del(.TotalLoginCount)
del(.CreatedOn)
del(.LastLoginTime)
del(.LastPasswordChange)
del(.LastIncorrectPassword)
del(.ExpiresOn)
del(.UserName)
del(.FullName)
del(.PasswordHint)
del(.Groups)
del(.UserComment)
del(.HomeDirectory)
del(.InternetUserName)
del(.ResetData)
del(.AccountDisabled)
del(.HomeDirectoryRequired)
del(.PasswordNotRequired)
del(.TempDuplicateAccount)
del(.NormalUserAccount)
del(.MnsLogonAccount)
del(.InterdomainTrustAccount)
del(.WorkstationTrustAccount)
del(.ServerTrustAccount)
del(.PasswordDoesNotExpire)
del(.AutoLocked)
del(.path)
del(.mtime)
del(.name)
del(.data)
del(.type)
del(.size)
del(.is_placeholder)
del(.security_descriptor)
del(.ogre_md)

# -----------------------------------------------------------------------------
# timeline
# -----------------------------------------------------------------------------
if exists(.registry.path) && exists(.registry.value) {
  .message = "Registry value " + to_string!(.registry.value) + " exists in key " + to_string!(.registry.path)
  if !is_array(.relationships) { .relationships = [] }
  .relationships = push!(.relationships, {"source": to_string!(.registry.path), "target": to_string!(.registry.value), "type": "contains"})
}
if .registry.hive == "SAM" && exists(.user.id) && exists(.user.name) {
  .message = "User account " + to_string!(.user.name) + " (RID " + to_string!(.user.id) + ") exists in SAM"
}
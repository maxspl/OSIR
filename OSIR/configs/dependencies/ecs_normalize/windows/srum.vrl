##############################################################
# Module VRL : srum
# Version    : 1.0
# Windows SRUM (Artemis JSONL + dfir-ogre SRUM JSONL) → ECS
#
# Fichier généré automatiquement à partir de la configuration YAML.
# Ne pas éditer directement — modifier la configuration source.
##############################################################

# -----------------------------------------------------------------------------
# normalize dotted fields
# -----------------------------------------------------------------------------
if exists(."labels.app_id") {
  .labels.app_id = get!(., path: ["labels.app_id"])
  del(."labels.app_id")
}
if exists(."user.id") {
  .user.id = get!(., path: ["user.id"])
  del(."user.id")
}

# -----------------------------------------------------------------------------
# transformations
# -----------------------------------------------------------------------------

# [normalization] encode_json!(.) -> event.original
.event.original = encode_json!(.)

# [normalization] windows.srum -> event.dataset
.event.dataset = "windows.srum"

# [normalization] windows -> event.module
.event.module = "windows"

# [normalization] event -> event.kind
.event.kind = "event"

# [normalization] ['process'] -> event.category
.event.category = ["process"]

# [normalization] ['info'] -> event.type
.event.type = ["info"]

# [normalization] Windows System Resource Usage Monitor (SRUM) -> event.provider
.event.provider = "Windows System Resource Usage Monitor (SRUM)"

# [normalization] success -> event.outcome
.event.outcome = "success"

# [normalization] timestamp -> timestamp
if exists(.auto_inc_id) && exists(.app_id) && exists(.timestamp) {
  _result, err = parse_timestamp(.timestamp, format: "%Y-%m-%dT%H:%M:%S%.f%z")
  if err == null {
    .timestamp = _result
  } else {
    log("[srum] échec de l'opération parse_timestamp sur timestamp : " + err, level: "warn")
  }
}

# [normalization] auto_inc_id -> labels.incremental_id
if exists(.auto_inc_id) && exists(.app_id) {
  _result, err = to_int(.auto_inc_id)
  if err == null {
    .labels.incremental_id = _result
  } else {
    log("[srum] échec de l'opération to_int sur labels.incremental_id : " + err, level: "warn")
  }
}

# [normalization] app_id -> labels.app_id
if exists(.auto_inc_id) && exists(.app_id) {
  .labels.app_id = .app_id
}

# [normalization] user_id -> user.id
if exists(.auto_inc_id) && exists(.app_id) && exists(.user_id) {
  .user.id = .user_id
}


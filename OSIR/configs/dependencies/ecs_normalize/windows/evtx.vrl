# [normalization] Event.EventData.TransmittedServices -> action.properties.TransmittedServices
if exists(.Event.EventData.TransmittedServices) {
  .action.properties.TransmittedServices = .Event.EventData.TransmittedServices
}

# [custom]
if is_object(.Event.UserData) {
  ud_obj = object!(.Event.UserData)
  ud_keys = keys(ud_obj)
  if length(ud_keys) > 0 {
    ud_root = string!(ud_keys[0])
    ud = get!(ud_obj, [ud_root])
    if is_object(ud) {
      ud_attrs = object(get(ud, ["#attributes"]) ?? {}) ?? {}
      ud_attrs = remove!(ud_attrs, ["xmlns"])
      ud = remove!(ud, ["#attributes"])
      .action.properties = merge(object(.action.properties) ?? {}, merge(ud_attrs, object!(ud)))
    } else {
      .action.properties = merge(object(.action.properties) ?? {}, set!({}, [ud_root], ud))
    }
    .action.properties.UserDataType = ud_root
  }
}

# [normalization] Event.EventData.Image -> action.properties.Image
if exists(.Event.EventData.Image) {
  .action.properties.Image = .Event.EventData.Image
}

# [normalization] parsed_message_kv.Image -> action.properties.Image
if !exists(.Event.EventData.Image) && exists(.parsed_message_kv.Image) {
  .action.properties.Image = .parsed_message_kv.Image
}

# [normalization] Event.EventData.DestinationPort -> action.properties.DestinationPort
if exists(.Event.EventData.DestinationPort) {
  .action.properties.DestinationPort = .Event.EventData.DestinationPort
}

# [normalization] Event.EventData.DestPort -> action.properties.DestinationPort
if !exists(.action.properties.DestinationPort) && exists(.Event.EventData.DestPort) {
  .action.properties.DestinationPort = .Event.EventData.DestPort
}

# [normalization] Event.EventData.ErrorCode -> action.properties.ErrorCode
if exists(.Event.EventData.ErrorCode) {
  .action.properties.ErrorCode = .Event.EventData.ErrorCode
}

# [normalization] Event.EventData.ProcessName -> action.properties.ProcessName
if exists(.Event.EventData.ProcessName) {
  .action.properties.ProcessName = .Event.EventData.ProcessName
}

# [normalization] to_int!(.Event.System.EventID."#text") -> event.code
if exists(.Event.System.EventID."#text") {
  .event.code = to_int!(.Event.System.EventID."#text")
}

# [normalization] to_int!(.Event.System.EventID) -> event.code
if !exists!(.event.code) && exists(.Event.System.EventID) {
  .event.code = to_int!(.Event.System.EventID)
}

# [normalization] to_string!(.Event.System.EventRecordID) -> event.record
if exists(.Event.System.EventRecordID) {
  .event.record = to_string!(.Event.System.EventRecordID)
}

# [normalization] event.code -> event.id
if exists(.event.code) {
  .event.id = .event.code
}

# [normalization] to_string!(.Event.System.Channel) -> action.type
if exists(.Event.System.Channel) {
  .action.type = to_string!(.Event.System.Channel)
}

